# APP_URL: The URL where this applet is hosted (e.g. https://my-cadet-academy.netlify.app)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, Discord review links, and cadet exam URLs.
APP_URL="MY_APP_URL"

# DISCORD_WEBHOOK_URL: Webhook URL for your Discord Forum or text channel.
# Create this in Discord: Channel Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=""

# GEMINI_API_KEY: Optional Gemini AI key if using AI assistance
GEMINI_API_KEY="MY_GEMINI_API_KEY"
