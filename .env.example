# ===== Обов'язкові =====
# Публічна адреса сайту БЕЗ слеша в кінці. Саме з неї будується Discord Redirect URI (APP_URL/auth/callback).
# На Render: https://cadet-academy.onrender.com  (якщо не задано — береться RENDER_EXTERNAL_URL)
APP_URL="https://cadet-academy.onrender.com"

# Ключ для підпису сесій (довгий випадковий рядок). Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Резервний вхід Куратора (вкладка «Вхід для Куратора»). Без ADMIN_PASSWORD вхід вимкнено.
ADMIN_LOGIN="sheriff"
ADMIN_PASSWORD=""

# ===== Discord OAuth (секрет зберігайте ТІЛЬКИ тут, не в базі й не в репозиторії) =====
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_LEADER_ROLE_ID=""
DISCORD_INSTRUCTOR_ROLE_ID=""

# ===== Інше =====
# Необов'язковий PIN для підтвердження зміни ролей (інакше достатньо слова ПІДТВЕРДЖУЮ)
LEADER_SECURITY_PIN=""
DISCORD_WEBHOOK_URL=""

# Supabase (постійне сховище; на Render файлова система тимчасова)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Render ставить NODE_ENV=production автоматично; сервер також розпізнає змінну RENDER
NODE_ENV="production"
