export type UserRole = 'leader' | 'instructor' | 'cadet';

export interface RoleAuditLogEntry {
  id: string;
  timestamp: string;
  actorName: string;
  actorDiscordId?: string;
  targetRole: UserRole;
  oldTitle: string;
  newTitle: string;
  oldDiscordRoleId: string;
  newDiscordRoleId: string;
  reason?: string;
}

export interface User {
  id: string;
  name: string;
  role: UserRole;
  staticId?: string;
  discordId?: string;
  discordUsername?: string;
  discordAvatar?: string;
  authMethod?: 'discord_oauth' | 'manual' | 'discord_id';
  customRoleTitle?: string;
}

export type QuestionType = 'single' | 'multiple' | 'open';

export interface Question {
  id: string;
  type: QuestionType;
  title: string;
  category: string;
  description?: string;
  options?: string[];
  correctOption?: number; // 0-indexed for single
  correctOptions?: number[]; // array of indices for multiple
  maxPoints: number;
  explanation?: string;
}

export interface TestConfig {
  id: string;
  title: string;
  description: string;
  category: string;
  timeLimitMinutes: number;
  passingScorePercent: number;
  randomQuestionCount: number;
  maxAttempts: number;
  cooldownHours: number;
  isActive: boolean;
  questions: Question[];
}

export interface ExamToken {
  id: string;
  token: string;
  testId: string;
  testTitle: string;
  cadetNickname: string;
  cadetStatic: string;
  cadetDiscord: string;
  instructorId: string;
  instructorName: string;
  createdAt: string;
  expiresAt: string;
  startedAt?: string;
  completedAt?: string;
  status: 'pending' | 'in_progress' | 'submitted' | 'expired';
  selectedQuestionIds: string[];
  optionsShuffle: Record<string, number[]>; // questionId -> [shuffled option indices]
}

export interface AntiCheatEvent {
  type: 'tab_switch' | 'fullscreen_exit' | 'copy_paste' | 'devtools' | 'blur';
  timestamp: string;
  details: string;
}

export interface AnswerSubmission {
  questionId: string;
  type: QuestionType;
  selectedOption?: number;
  selectedOptions?: number[];
  textAnswer?: string;
  autoScore?: number;
  manualScore?: number;
  maxPoints: number;
