}

export interface ExamResult {
  id: string;
  token: string;
  testId: string;
  testTitle: string;
  cadetNickname: string;
  cadetStatic: string;
  cadetDiscord: string;
  instructorId: string;
  instructorName: string;
  startedAt: string;
  submittedAt: string;
  timeSpentSeconds: number;
  autoScore: number;
  maxAutoScore: number;
  manualScore: number;
  maxManualScore: number;
  totalScore: number;
  maxTotalScore: number;
  percentage: number;
  autoPassed: boolean;
  hasOpenQuestions: boolean;
  status: 'pending_review' | 'passed' | 'failed' | 'retake_allowed';
  instructorDecision?: {
    instructorId: string;
    instructorName: string;
    decision: 'passed' | 'failed' | 'retake_allowed';
    comment: string;
    decidedAt: string;
  };
