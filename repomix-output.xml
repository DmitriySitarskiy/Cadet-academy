<file path="src/components/CadetLookupModal.tsx">
import React, { useState } from 'react';
import { Search, UserCheck, CheckCircle2, XCircle, Clock, RotateCcw, X, History, ExternalLink } from 'lucide-react';
import { ExamResult } from '../types';
import { api } from '../services/api';

interface CadetLookupModalProps {
  onClose: () => void;
  onSelectResult: (resultId: string) => void;
}

export const CadetLookupModal: React.FC<CadetLookupModalProps> = ({
  onClose,
  onSelectResult,
}) => {
  const [query, setQuery] = useState('');
  const [history, setHistory] = useState<ExamResult[]>([]);
  const [searched, setSearched] = useState(false);
  const [loading, setLoading] = useState(false);

  const handleSearch = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!query.trim()) return;

    setLoading(true);
    setSearched(true);
    try {
      const results = await api.searchCadetHistory(query.trim());
      setHistory(results);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4">
      <div className="max-w-2xl w-full p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl space-y-6 max-h-[85vh] flex flex-col">
        <div className="flex items-center justify-between pb-3 border-b border-slate-800 shrink-0">
          <div className="flex items-center gap-2">
            <History className="w-5 h-5 text-amber-400" />
            <h2 className="text-base font-bold text-white">
              Пошук особової справи та історії іспитів кадета
            </h2>
          </div>
          <button onClick={onClose} className="text-slate-400 hover:text-white">
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Search Bar */}
        <form onSubmit={handleSearch} className="flex items-center gap-2 shrink-0">
          <div className="relative flex-1">
            <Search className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              placeholder="Введіть нікнейм, статік (#12904) або Discord ID..."
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              className="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 font-mono"
            />
          </div>
          <button
            type="submit"
            disabled={loading}
            className="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs transition-colors shrink-0"
          >
            {loading ? 'Пошук...' : 'Знайти'}
          </button>
        </form>

        {/* Results List */}
        <div className="overflow-y-auto flex-1 space-y-3 pr-1 text-xs">
          {!searched && (
            <div className="text-center py-12 text-slate-500 text-xs">
              Введіть статік або нікнейм кадета для перевірки попередніх спроб, результатів та права на перездачу.
            </div>
          )}

          {searched && history.length === 0 && (
            <div className="text-center py-12 text-slate-500 text-xs">
              Жодного запису не знайдено для "{query}". Можливо, кадет ще не складав іспити.
            </div>
          )}

          {history.map((item) => {
            const isPassed = item.status === 'passed';
            const isFailed = item.status === 'failed';
            const isPending = item.status === 'pending_review';
            const isRetake = item.status === 'retake_allowed';

            return (
              <div
                key={item.id}
                onClick={() => {
                  onSelectResult(item.id);
                  onClose();
                }}
                className="p-4 rounded-xl bg-slate-950/70 border border-slate-800 hover:border-slate-700 transition-colors cursor-pointer space-y-2 group"
              >
                <div className="flex items-start justify-between gap-2">
                  <div>
                    <div className="font-bold text-white text-sm group-hover:text-amber-400 transition-colors">
                      {item.testTitle}
                    </div>
                    <div className="text-[11px] text-slate-400 font-mono">
                      Кадет: {item.cadetNickname} ({item.cadetStatic}) · Інструктор: {item.instructorName}
                    </div>
                  </div>

                  <div className="text-right shrink-0">
                    {isPassed && (
                      <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Зараховано
                      </span>
                    )}
                    {isFailed && (
                      <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/10 text-red-400 border border-red-500/20">
                        Не зараховано
                      </span>
                    )}
                    {isPending && (
                      <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                        На перевірці
                      </span>
                    )}
                    {isRetake && (
                      <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20">
                        Дозволено перездачу
                      </span>
                    )}
                  </div>
                </div>

                <div className="flex items-center justify-between text-[11px] text-slate-400 pt-1 border-t border-slate-800/60">
                  <span className="tabular-nums">
                    Результат: <strong className="text-white">{item.totalScore}/{item.maxTotalScore} б. ({item.percentage}%)</strong>
                  </span>
                  <span>
                    Дата: {new Date(item.submittedAt).toLocaleDateString('uk-UA')}
                  </span>
                </div>

                {item.instructorDecision?.comment && (
                  <div className="text-[11px] text-slate-300 bg-slate-900 p-2 rounded border border-slate-800/80 italic">
                    «{item.instructorDecision.comment}»
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/components/ExamTaker.tsx">
import React, { useState, useEffect, useRef, useCallback } from 'react';
import {
  Shield,
  ShieldAlert,
  Clock,
  AlertTriangle,
  CheckCircle2,
  XCircle,
  HelpCircle,
  Maximize2,
  Lock,
  Send,
  ArrowRight,
  Info
} from 'lucide-react';
import { AntiCheatEvent } from '../types';
import { api } from '../services/api';

interface ExamTakerProps {
  token: string;
  onExit: () => void;
}

interface QuestionClient {
  id: string;
  type: 'single' | 'multiple' | 'open';
  title: string;
  description?: string;
  category: string;
  options?: string[];
  maxPoints: number;
}

interface ExamData {
  token: string;
  testTitle: string;
  testDescription: string;
  timeLimitMinutes: number;
  passingScorePercent: number;
  cadetNickname: string;
  cadetStatic: string;
  cadetDiscord: string;
  startedAt: string;
  serverNow: string;
  questions: QuestionClient[];
}

export const ExamTaker: React.FC<ExamTakerProps> = ({ token, onExit }) => {
  const [examData, setExamData] = useState<ExamData | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Flow states: 'confirm' | 'taking' | 'completed'
  const [flowState, setFlowState] = useState<'confirm' | 'taking' | 'completed'>('confirm');

  // Answers state
  const [currentIndex, setCurrentIndex] = useState(0);
  const [answers, setAnswers] = useState<
    Record<
      string,
      { selectedOption?: number; selectedOptions?: number[]; textAnswer?: string }
    >
  >({});

  // Anti-cheat state
  const [antiCheatEvents, setAntiCheatEvents] = useState<AntiCheatEvent[]>([]);
  const [lastWarning, setLastWarning] = useState<string | null>(null);
  const [warningTimeout, setWarningTimeout] = useState<any>(null);

  // Timer state
  const [timeLeftSeconds, setTimeLeftSeconds] = useState<number>(0);
  const [submitting, setSubmitting] = useState(false);
  const [submissionResult, setSubmissionResult] = useState<any>(null);

  // Keep ref for auto-submit when timer expires
  const answersRef = useRef(answers);
  answersRef.current = answers;
  const antiCheatRef = useRef(antiCheatEvents);
  antiCheatRef.current = antiCheatEvents;
  const startTimeRef = useRef<number>(Date.now());

  // Record an anti-cheat event
  const logAntiCheat = useCallback((type: AntiCheatEvent['type'], details: string) => {
    const newEvent: AntiCheatEvent = {
      type,
      timestamp: new Date().toISOString(),
      details,
    };
    setAntiCheatEvents((prev) => [...prev, newEvent]);

    // Show warning banner
    let warnMsg = '⚠️ Зафіксовано порушення регламенту тестування!';
    if (type === 'tab_switch' || type === 'blur') {
      warnMsg = '⚠️ Зафіксовано вихід зі вкладки або згортання браузера! Подія записана у протокол для інструктора.';
    } else if (type === 'fullscreen_exit') {
      warnMsg = '⚠️ Зафіксовано вихід із повноекранного режиму!';
    } else if (type === 'copy_paste') {
      warnMsg = '⚠️ Спроба копіювання або вставки тексту заборонена і записана в протокол!';
    }

    setLastWarning(warnMsg);
    if (warningTimeout) clearTimeout(warningTimeout);
    const t = setTimeout(() => setLastWarning(null), 5000);
    setWarningTimeout(t);
  }, [warningTimeout]);

  // Load exam
  useEffect(() => {
    const fetchExam = async () => {
      try {
        setLoading(true);
        const data = await api.getExamByToken(token);
        setExamData(data);
        const durationSec = data.timeLimitMinutes * 60;
        setTimeLeftSeconds(durationSec);
      } catch (err: any) {
        setError(err.message || 'Не вдалося завантажити іспит');
      } finally {
        setLoading(false);
      }
    };
    fetchExam();
  }, [token]);

  // Anti-cheat event listeners while taking exam
  useEffect(() => {
    if (flowState !== 'taking') return;

    const handleVisibilityChange = () => {
      if (document.hidden) {
        logAntiCheat('tab_switch', 'Перемикання на іншу вкладку браузера');
      }
    };

    const handleWindowBlur = () => {
      logAntiCheat('blur', 'Втрата фокусу вікна (можливе використання сторонніх програм)');
    };

    const handleFullscreenChange = () => {
      if (!document.fullscreenElement) {
        logAntiCheat('fullscreen_exit', 'Вихід з повноекранного режиму під час тесту');
      }
    };

    const handleCopy = (e: ClipboardEvent) => {
      e.preventDefault();
      logAntiCheat('copy_paste', 'Спроба копіювання тексту питання в буфер');
    };

    const handlePaste = (e: ClipboardEvent) => {
      // Allow paste in open answer only if not suspicious, or log it
      logAntiCheat('copy_paste', 'Вставка тексту з буфера обміну');
    };

    const handleContextMenu = (e: MouseEvent) => {
      e.preventDefault();
      logAntiCheat('devtools', 'Спроба виклику контекстного меню (ПКМ)');
    };

    document.addEventListener('visibilitychange', handleVisibilityChange);
    window.addEventListener('blur', handleWindowBlur);
    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('copy', handleCopy);
    document.addEventListener('paste', handlePaste);
    document.addEventListener('contextmenu', handleContextMenu);

    return () => {
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      window.removeEventListener('blur', handleWindowBlur);
      document.removeEventListener('fullscreenchange', handleFullscreenChange);
      document.removeEventListener('copy', handleCopy);
      document.removeEventListener('paste', handlePaste);
      document.removeEventListener('contextmenu', handleContextMenu);
    };
  }, [flowState, logAntiCheat]);

  // Countdown timer
  useEffect(() => {
    if (flowState !== 'taking') return;

    const timer = setInterval(() => {
      setTimeLeftSeconds((prev) => {
        if (prev <= 1) {
          clearInterval(timer);
          // Auto submit
          handleFinalSubmit(true);
          return 0;
        }
        return prev - 1;
      });
    }, 1000);

    return () => clearInterval(timer);
  }, [flowState]);

  // Enter Fullscreen and start
  const handleStartExam = async () => {
    try {
      if (document.documentElement.requestFullscreen) {
        await document.documentElement.requestFullscreen().catch(() => {});
      }
    } catch (e) {
      // Ignore fullscreen denial in some restricted iframes
    }
    startTimeRef.current = Date.now();
    setFlowState('taking');
  };

  // Answer handler
  const handleSelectSingleOption = (qid: string, optionIndex: number) => {
    setAnswers((prev) => ({
      ...prev,
      [qid]: {
        ...prev[qid],
        selectedOption: optionIndex,
      },
    }));
  };

  const handleToggleMultipleOption = (qid: string, optionIndex: number) => {
    const current = answers[qid]?.selectedOptions || [];
    const next = current.includes(optionIndex)
      ? current.filter((i) => i !== optionIndex)
      : [...current, optionIndex];

    setAnswers((prev) => ({
      ...prev,
      [qid]: {
        ...prev[qid],
        selectedOptions: next,
      },
    }));
  };

  const handleOpenTextChange = (qid: string, text: string) => {
    setAnswers((prev) => ({
      ...prev,
      [qid]: {
        ...prev[qid],
        textAnswer: text,
      },
    }));
  };

  // Next question
  const handleNext = () => {
    if (!examData) return;
    if (currentIndex < examData.questions.length - 1) {
      setCurrentIndex((prev) => prev + 1);
    } else {
      handleFinalSubmit(false);
    }
  };

  // Final Submit
  const handleFinalSubmit = async (isAutoTimeout = false) => {
    if (submitting) return;
    setSubmitting(true);

    if (isAutoTimeout) {
      logAntiCheat('blur', 'Час тестування вичерпано. Робота збережена автоматично.');
    }

    try {
      const timeSpentSeconds = Math.round((Date.now() - startTimeRef.current) / 1000);

      const formattedAnswers = Object.entries(answersRef.current).map(([qid, val]) => ({
        questionId: qid,
        selectedOption: val.selectedOption,
        selectedOptions: val.selectedOptions,
        textAnswer: val.textAnswer,
      }));

      // Ensure all questions are present
      examData?.questions.forEach((q) => {
        if (!formattedAnswers.find((a) => a.questionId === q.id)) {
          formattedAnswers.push({
            questionId: q.id,
            selectedOption: undefined,
            selectedOptions: undefined,
            textAnswer: '',
          });
        }
      });

      const res = await api.submitExam(token, {
        answers: formattedAnswers,
        antiCheatEvents: antiCheatRef.current,
        timeSpentSeconds,
      });

      setSubmissionResult(res);
      setFlowState('completed');

      // Exit fullscreen if active
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    } catch (err: any) {
      setError(err.message || 'Помилка надсилання відповідей');
    } finally {
      setSubmitting(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-4">
        <div className="text-center space-y-4">
          <div className="w-12 h-12 border-4 border-amber-400 border-t-transparent rounded-full animate-spin mx-auto" />
          <div className="text-sm font-medium text-slate-300">Завантаження безпечного сеансу іспиту...</div>
        </div>
      </div>
    );
  }

  if (error || !examData) {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-4">
        <div className="max-w-md w-full p-8 rounded-2xl bg-slate-900 border border-slate-800 text-center space-y-4">
          <div className="w-14 h-14 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 flex items-center justify-center mx-auto">
            <XCircle className="w-8 h-8" />
          </div>
          <h2 className="text-xl font-bold text-white">Доступ заборонено або вичерпано</h2>
          <p className="text-xs text-slate-400 leading-relaxed">
            {error || 'Посилання недійсне, прострочене або тест уже було складено раніше.'}
          </p>
          <button
            onClick={onExit}
            className="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition-colors"
          >
            Повернутися до Академії
          </button>
        </div>
      </div>
    );
  }

  // ==================== SCREEN 1: CONFIRMATION ====================
  if (flowState === 'confirm') {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-4">
        <div className="max-w-2xl w-full p-8 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl space-y-6">
          <div className="flex items-center gap-4 pb-6 border-b border-slate-800">
            <div className="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
              <Shield className="w-7 h-7" />
            </div>
            <div>
              <span className="text-xs text-amber-400 font-semibold uppercase tracking-wider block">
                Академія Кадетів • Офіційний екзаменаційний бланк
              </span>
              <h1 className="text-xl font-bold text-white">{examData.testTitle}</h1>
            </div>
          </div>

          {/* Cadet Credentials Confirmation */}
          <div className="p-4 rounded-xl bg-slate-950/80 border border-slate-800 space-y-2">
            <div className="text-xs font-semibold text-slate-400 uppercase tracking-wider">
              Підтвердження особи кадета
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
              <div>
                <span className="text-[11px] text-slate-500 block">Нікнейм</span>
                <span className="text-sm font-bold text-white">{examData.cadetNickname}</span>
              </div>
              <div>
                <span className="text-[11px] text-slate-500 block">Статік (ID)</span>
                <span className="text-sm font-bold text-amber-400 font-mono">{examData.cadetStatic}</span>
              </div>
              <div>
                <span className="text-[11px] text-slate-500 block">Discord</span>
                <span className="text-sm font-mono text-slate-300">
                  {examData.cadetDiscord ? `@${examData.cadetDiscord}` : '—'}
                </span>
              </div>
            </div>
          </div>

          {/* Exam Specs */}
          <div className="grid grid-cols-3 gap-4 text-center">
            <div className="p-3.5 rounded-xl bg-slate-950/50 border border-slate-800">
              <Clock className="w-5 h-5 text-amber-400 mx-auto mb-1" />
              <div className="text-base font-bold text-white tabular-nums">{examData.timeLimitMinutes} хв</div>
              <div className="text-[10px] text-slate-400">Час на іспит</div>
            </div>
            <div className="p-3.5 rounded-xl bg-slate-950/50 border border-slate-800">
              <HelpCircle className="w-5 h-5 text-blue-400 mx-auto mb-1" />
              <div className="text-base font-bold text-white tabular-nums">{examData.questions.length}</div>
              <div className="text-[10px] text-slate-400">Кількість питань</div>
            </div>
            <div className="p-3.5 rounded-xl bg-slate-950/50 border border-slate-800">
              <CheckCircle2 className="w-5 h-5 text-emerald-400 mx-auto mb-1" />
              <div className="text-base font-bold text-white tabular-nums">{examData.passingScorePercent}%</div>
              <div className="text-[10px] text-slate-400">Прохідний бал</div>
            </div>
          </div>

          {/* Anti-cheat & Security Rules */}
          <div className="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 space-y-2">
            <div className="text-xs font-bold text-amber-300 flex items-center gap-1.5 uppercase tracking-wide">
              <ShieldAlert className="w-4 h-4 text-amber-400" />
              Правила проходження та система антисписування
            </div>
            <ul className="text-xs text-amber-200/90 space-y-1.5 list-disc list-inside">
              <li>
                <strong>Питання показуються по одному</strong>, повернення до попередніх питань неможливе.
              </li>
              <li>
                <strong>Контроль фокусу:</strong> вихід зі вкладки або згортання браузера фіксується у протоколі.
              </li>
              <li>
                <strong>Повноекранний режим:</strong> іспит проводиться у повноекранному режимі. Вихід фіксується.
              </li>
              <li>
                <strong>Одноразове посилання:</strong> повторний вхід або оновлення сторінки призведе до анулювання спроби.
              </li>
            </ul>
          </div>

          <div className="pt-2 flex flex-col sm:flex-row items-center gap-3">
            <button
              onClick={onExit}
              className="w-full sm:w-auto px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition-colors"
            >
              Скасувати
            </button>
            <button
              onClick={handleStartExam}
              className="w-full sm:flex-1 py-3 px-6 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-sm transition-all shadow-md shadow-amber-500/20 flex items-center justify-center gap-2"
            >
              <Maximize2 className="w-4 h-4" />
              Підтверджую дані — Розпочати іспит
            </button>
          </div>
        </div>
      </div>
    );
  }

  // ==================== SCREEN 3: COMPLETED ====================
  if (flowState === 'completed' && submissionResult) {
    const isSuccess = submissionResult.status === 'passed';
    const isPending = submissionResult.status === 'pending_review';

    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-4">
        <div className="max-w-xl w-full p-8 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl text-center space-y-6">
          <div
            className={`w-16 h-16 rounded-2xl flex items-center justify-center mx-auto ${
              isSuccess
                ? 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-400'
                : isPending
                ? 'bg-blue-500/10 border border-blue-500/20 text-blue-400'
                : 'bg-red-500/10 border border-red-500/20 text-red-400'
            }`}
          >
            {isSuccess ? (
              <CheckCircle2 className="w-10 h-10" />
            ) : isPending ? (
              <Clock className="w-10 h-10" />
            ) : (
              <XCircle className="w-10 h-10" />
            )}
          </div>

          <div>
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">
              {examData.testTitle}
            </span>
            <h1 className="text-2xl font-bold text-white">
              {isSuccess
                ? 'Іспит успішно складено!'
                : isPending
                ? 'Роботу відправлено на перевірку інструкторам'
                : 'Іспит не складено'}
            </h1>
          </div>

          <div className="p-5 rounded-xl bg-slate-950/70 border border-slate-800 grid grid-cols-2 gap-4 text-left">
            <div>
              <span className="text-xs text-slate-500 block">Кадет:</span>
              <span className="text-sm font-semibold text-white">
                {examData.cadetNickname} ({examData.cadetStatic})
              </span>
            </div>
            <div>
              <span className="text-xs text-slate-500 block">Автоматичні бали:</span>
              <span className="text-sm font-bold text-amber-400 tabular-nums">
                {submissionResult.autoScore} / {submissionResult.maxAutoScore} б. ({submissionResult.percentage}%)
              </span>
            </div>
            <div className="col-span-2 pt-2 border-t border-slate-800/80">
              <span className="text-xs text-slate-500 block">Статус у системі:</span>
              <span
                className={`text-sm font-bold ${
                  isSuccess ? 'text-emerald-400' : isPending ? 'text-blue-400' : 'text-red-400'
                }`}
              >
                {isSuccess
                  ? 'Зараховано (Автоматично)'
                  : isPending
                  ? 'Очікує ручної перевірки відкритих ситуаційних кейсів інструктором'
                  : 'Не зараховано (Нижче прохідного балу)'}
              </span>
            </div>
          </div>

          <div className="p-4 rounded-xl bg-slate-950/40 border border-slate-800/60 text-xs text-slate-400 text-left space-y-2">
            <div className="flex items-center gap-2 font-medium text-slate-300">
              <Info className="w-4 h-4 text-amber-400 shrink-0" />
              Що відбувається далі?
            </div>
            <p>
              1. Повний звіт з розшифровкою відповідей автоматично надіслано в Forum-канал інструкторів у Discord.
            </p>
            <p>
              2. Інструктор перевірить ваші відповіді на ситуаційні кейси та винесе остаточний вердикт: «Зараховано», «Не зараховано» або «Дозволити перездачу».
            </p>
            <p>
              3. Сповіщення надійде у вашу Discord-гілку.
            </p>
          </div>

          <button
            onClick={onExit}
            className="w-full py-3 px-6 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs transition-colors"
          >
            Повернутися на головну
          </button>
        </div>
      </div>
    );
  }

  // ==================== SCREEN 2: TAKING THE EXAM ====================
  const currentQ = examData.questions[currentIndex];
  const totalQuestions = examData.questions.length;
  const isLastQuestion = currentIndex === totalQuestions - 1;

  const minutes = Math.floor(timeLeftSeconds / 60);
  const seconds = timeLeftSeconds % 60;
  const isTimeCritical = timeLeftSeconds < 120; // Under 2 mins

  const currentAnswer = answers[currentQ.id] || {};

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col select-none">
      {/* Warning Toast if Anti-Cheat Triggered */}
      {lastWarning && (
        <div className="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-lg w-full px-4 animate-in slide-in-from-top-4 duration-300">
          <div className="p-3.5 rounded-xl bg-red-500/90 text-white text-xs font-semibold shadow-2xl flex items-center gap-3 backdrop-blur border border-red-400/50">
            <AlertTriangle className="w-5 h-5 shrink-0 animate-bounce" />
            <div>{lastWarning}</div>
          </div>
        </div>
      )}

      {/* Top HUD */}
      <header className="sticky top-0 z-40 bg-slate-900 border-b border-slate-800 px-4 sm:px-8 py-3">
        <div className="max-w-4xl mx-auto flex items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-lg bg-amber-400/10 border border-amber-400/20 text-amber-400 flex items-center justify-center shrink-0">
              <Shield className="w-4 h-4" />
            </div>
            <div>
              <div className="text-xs font-bold text-white truncate max-w-[200px] sm:max-w-md">
                {examData.testTitle}
              </div>
              <div className="text-[10px] text-slate-400 font-mono">
                Кадет: {examData.cadetNickname} ({examData.cadetStatic})
              </div>
            </div>
          </div>

          <div className="flex items-center gap-4">
            {/* Anti-cheat active badge */}
            <div className="hidden sm:flex items-center gap-1.5 text-[11px] font-medium text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">
              <Lock className="w-3 h-3" />
              Античит активний
            </div>

            {/* Timer HUD */}
            <div
              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg border tabular-nums font-mono font-bold text-sm ${
                isTimeCritical
                  ? 'bg-red-500/10 border-red-500/40 text-red-400 animate-pulse'
                  : 'bg-slate-800 border-slate-700 text-amber-400'
              }`}
            >
              <Clock className="w-4 h-4" />
              <span>
                {String(minutes).padStart(2, '0')}:{String(seconds).padStart(2, '0')}
              </span>
            </div>
          </div>
        </div>
      </header>

      {/* Progress Line */}
      <div className="w-full bg-slate-900 h-1.5">
        <div
          className="bg-amber-400 h-1.5 transition-all duration-300"
          style={{ width: `${((currentIndex + 1) / totalQuestions) * 100}%` }}
        />
      </div>

      {/* Main Question Viewport */}
      <main className="flex-1 max-w-3xl w-full mx-auto px-4 py-8 flex flex-col justify-between">
        <div className="space-y-6">
          {/* Question Index & Category */}
          <div className="flex items-center justify-between text-xs text-slate-400 border-b border-slate-800/80 pb-3">
            <span className="font-semibold text-amber-400 tracking-wide uppercase">
              {currentQ.category || 'Загальне запитання'}
            </span>
            <span className="font-mono">
              Питання <strong className="text-white">{currentIndex + 1}</strong> з {totalQuestions}
            </span>
          </div>

          {/* Question Title & Prompt */}
          <div className="space-y-2">
            <h2 className="text-lg sm:text-xl font-bold text-white leading-relaxed">
              {currentQ.title}
            </h2>
            {currentQ.description && (
              <p className="text-sm text-slate-300 leading-relaxed p-4 rounded-xl bg-slate-900/60 border border-slate-800/80">
                {currentQ.description}
              </p>
            )}
          </div>

          {/* Question Type Hint */}
          <div className="text-[11px] text-slate-500 italic">
            {currentQ.type === 'single' && 'Оберіть одну правильну відповідь:'}
            {currentQ.type === 'multiple' && 'Оберіть усі правильні відповіді (може бути кілька):'}
            {currentQ.type === 'open' && 'Розгорнута відповідь (оцінюється інструктором вручну):'}
          </div>

          {/* Options: Single Choice */}
          {currentQ.type === 'single' && currentQ.options && (
            <div className="space-y-3">
              {currentQ.options.map((optText, optIdx) => {
                const isSelected = currentAnswer.selectedOption === optIdx;
                return (
                  <button
                    key={optIdx}
                    type="button"
                    onClick={() => handleSelectSingleOption(currentQ.id, optIdx)}
                    className={`w-full text-left p-4 rounded-xl border text-sm transition-all flex items-start gap-3.5 ${
                      isSelected
                        ? 'bg-amber-500/10 border-amber-500 text-white font-medium shadow-sm shadow-amber-500/10'
                        : 'bg-slate-900/80 border-slate-800 hover:border-slate-700 text-slate-300'
                    }`}
                  >
                    <div
                      className={`w-5 h-5 rounded-full border flex items-center justify-center shrink-0 mt-0.5 ${
                        isSelected ? 'border-amber-400 bg-amber-400 text-slate-950' : 'border-slate-600'
                      }`}
                    >
                      {isSelected && <div className="w-2 h-2 rounded-full bg-slate-950" />}
                    </div>
                    <span className="leading-snug">{optText}</span>
                  </button>
                );
              })}
            </div>
          )}

          {/* Options: Multiple Choice */}
          {currentQ.type === 'multiple' && currentQ.options && (
            <div className="space-y-3">
              {currentQ.options.map((optText, optIdx) => {
                const isChecked = (currentAnswer.selectedOptions || []).includes(optIdx);
                return (
                  <button
                    key={optIdx}
                    type="button"
                    onClick={() => handleToggleMultipleOption(currentQ.id, optIdx)}
                    className={`w-full text-left p-4 rounded-xl border text-sm transition-all flex items-start gap-3.5 ${
                      isChecked
                        ? 'bg-amber-500/10 border-amber-500 text-white font-medium shadow-sm shadow-amber-500/10'
                        : 'bg-slate-900/80 border-slate-800 hover:border-slate-700 text-slate-300'
                    }`}
                  >
                    <div
                      className={`w-5 h-5 rounded-md border flex items-center justify-center shrink-0 mt-0.5 ${
                        isChecked ? 'border-amber-400 bg-amber-400 text-slate-950' : 'border-slate-600'
                      }`}
                    >
                      {isChecked && <CheckCircle2 className="w-4 h-4 text-slate-950 stroke-[3]" />}
                    </div>
                    <span className="leading-snug">{optText}</span>
                  </button>
                );
              })}
            </div>
          )}

          {/* Options: Open Situational Case */}
          {currentQ.type === 'open' && (
            <div className="space-y-2">
              <textarea
                rows={6}
                value={currentAnswer.textAnswer || ''}
                onChange={(e) => handleOpenTextChange(currentQ.id, e.target.value)}
                placeholder="Опишіть ваші покрокові дії, команди в гучномовець, радіодоповіді та застосування відповідної стадії сили..."
                className="w-full p-4 rounded-xl bg-slate-900 border border-slate-800 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors resize-y leading-relaxed"
              />
              <div className="text-[11px] text-slate-500 flex items-center justify-between">
                <span>Символів: {(currentAnswer.textAnswer || '').length}</span>
                <span>Макс. балів за кейс: {currentQ.maxPoints}</span>
              </div>
            </div>
          )}
        </div>

        {/* Bottom Navigation Control: Strictly Forward Only! */}
        <div className="pt-8 border-t border-slate-800/80 flex items-center justify-between gap-4 mt-8">
          <div className="text-[11px] text-slate-500 flex items-center gap-1.5">
            <Lock className="w-3.5 h-3.5 text-slate-400" />
            Повернення назад заборонено регламентом
          </div>

          <button
            type="button"
            disabled={submitting}
            onClick={handleNext}
            className="py-3 px-6 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs transition-all shadow-md shadow-amber-500/20 flex items-center gap-2 disabled:opacity-50"
          >
            {isLastQuestion ? (
              <>
                <Send className="w-4 h-4" />
                {submitting ? 'Надсилання...' : 'Завершити іспит'}
              </>
            ) : (
              <>
                <span>Наступне питання</span>
                <ArrowRight className="w-4 h-4" />
              </>
            )}
          </button>
        </div>
      </main>
    </div>
  );
};
</file>

<file path="src/components/InstructorAccountsModal.tsx">
import React, { useState } from 'react';
import { Users, UserPlus, Trash2, X, Shield, Check, AlertCircle } from 'lucide-react';
import { User } from '../types';
import { api } from '../services/api';

interface InstructorAccountsModalProps {
  instructors: User[];
  currentUser: User | null;
  onClose: () => void;
  onRefresh: () => void;
}

export const InstructorAccountsModal: React.FC<InstructorAccountsModalProps> = ({
  instructors,
  currentUser,
  onClose,
  onRefresh,
}) => {
  const isLeader = currentUser?.role === 'leader';
  const [name, setName] = useState('');
  const [role, setRole] = useState<'instructor' | 'leader'>('instructor');
  const [staticId, setStaticId] = useState('');
  const [discordId, setDiscordId] = useState('');
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleAdd = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;

    setSubmitting(true);
    setError(null);
    try {
      await api.addInstructor({
        name: name.trim(),
        role,
        staticId: staticId.trim(),
        discordId: discordId.trim(),
      });
      setName('');
      setStaticId('');
      setDiscordId('');
      onRefresh();
    } catch (err: any) {
      setError(err.message || 'Помилка додавання інструктора');
    } finally {
      setSubmitting(false);
    }
  };

  const handleDelete = async (id: string, instName: string) => {
    if (!confirm(`Ви дійсно бажаєте видалити інструктора ${instName}?`)) return;
    try {
      await api.deleteInstructor(id);
      onRefresh();
    } catch (err: any) {
      alert(err.message || 'Помилка видалення');
    }
  };

  return (
    <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4">
      <div className="max-w-xl w-full p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl space-y-6 max-h-[85vh] flex flex-col">
        <div className="flex items-center justify-between pb-3 border-b border-slate-800 shrink-0">
          <div className="flex items-center gap-2">
            <Users className="w-5 h-5 text-amber-400" />
            <h2 className="text-base font-bold text-white">Штат інструкторського корпусу</h2>
          </div>
          <button onClick={onClose} className="text-slate-400 hover:text-white">
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Instructors List */}
        <div className="overflow-y-auto space-y-2.5 max-h-56 pr-1">
          {instructors.map((u) => (
            <div
              key={u.id}
              className="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 flex items-center justify-between gap-3 text-xs"
            >
              <div className="flex items-center gap-3">
                <div className="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-amber-400 font-bold shrink-0">
                  {u.role === 'leader' ? '⭐' : '🎓'}
                </div>
                <div>
                  <div className="font-semibold text-white">
                    {u.name}
                    {currentUser?.id === u.id && (
                      <span className="text-[10px] text-amber-400 font-mono ml-1.5">(Ви)</span>
                    )}
                  </div>
                  <div className="text-[11px] text-slate-400 font-mono">
                    {u.role === 'leader' ? 'Лідер фракції' : 'Інструктор'} · Статік: {u.staticId || '—'} · Discord: {u.discordId || '—'}
                  </div>
                </div>
              </div>

              {isLeader && instructors.length > 1 && u.id !== currentUser?.id && (
                <button
                  onClick={() => handleDelete(u.id, u.name)}
                  className="p-1.5 rounded-lg text-slate-500 hover:text-red-400 hover:bg-slate-800 transition-colors"
                  title="Видалити"
                >
                  <Trash2 className="w-4 h-4" />
                </button>
              )}
            </div>
          ))}
        </div>

        {/* Add Instructor Form (Leader only) */}
        {isLeader ? (
          <form onSubmit={handleAdd} className="pt-4 border-t border-slate-800 space-y-3 shrink-0">
            <div className="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
              <UserPlus className="w-4 h-4" />
              Призначити нового інструктора
            </div>

            {error && (
              <div className="p-2.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-300 text-xs">
                {error}
              </div>
            )}

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] text-slate-300 mb-1">
                  ПІБ / Нікнейм <span className="text-amber-400">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="напр. Андрій Шевченко"
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  className="w-full px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
                />
              </div>

              <div>
                <label className="block text-[11px] text-slate-300 mb-1">Роль у системі</label>
                <select
                  value={role}
                  onChange={(e) => setRole(e.target.value as any)}
                  className="w-full px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
                >
                  <option value="instructor">Інструктор</option>
                  <option value="leader">Лідер фракції</option>
                </select>
              </div>

              <div>
                <label className="block text-[11px] text-slate-300 mb-1">Статік ID</label>
                <input
                  type="text"
                  placeholder="#18492"
                  value={staticId}
                  onChange={(e) => setStaticId(e.target.value)}
                  className="w-full px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white font-mono"
                />
              </div>

              <div>
                <label className="block text-[11px] text-slate-300 mb-1">Discord ID / Тег</label>
                <input
                  type="text"
                  placeholder="shevchenko_doc"
                  value={discordId}
                  onChange={(e) => setDiscordId(e.target.value)}
                  className="w-full px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white font-mono"
                />
              </div>
            </div>

            <button
              type="submit"
              disabled={submitting}
              className="w-full py-2 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs transition-colors shadow-sm disabled:opacity-50"
            >
              {submitting ? 'Збереження...' : 'Додати інструктора'}
            </button>
          </form>
        ) : (
          <div className="p-3 rounded-xl bg-slate-950 text-xs text-slate-400 flex items-center gap-2">
            <AlertCircle className="w-4 h-4 text-amber-400 shrink-0" />
            Додавання нових інструкторів доступне лише користувачам із роллю «Лідер».
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/LeaderTestsAdmin.tsx">
import React, { useState } from 'react';
import {
  Plus,
  Edit2,
  Trash2,
  Clock,
  Award,
  RefreshCw,
  HelpCircle,
  ShieldAlert,
  Save,
  X,
  FileQuestion,
  CheckCircle2,
  Lock,
} from 'lucide-react';
import { TestConfig, Question, QuestionType, User } from '../types';
import { api } from '../services/api';

interface LeaderTestsAdminProps {
  tests: TestConfig[];
  currentUser: User | null;
  onRefreshTests: () => void;
}

export const LeaderTestsAdmin: React.FC<LeaderTestsAdminProps> = ({
  tests,
  currentUser,
  onRefreshTests,
}) => {
  const isLeader = currentUser?.role === 'leader';

  const [editingTest, setEditingTest] = useState<Partial<TestConfig> | null>(null);
  const [selectedTestForBank, setSelectedTestForBank] = useState<TestConfig | null>(null);

  // Question editing state
  const [editingQuestion, setEditingQuestion] = useState<{
    testId: string;
    question: Partial<Question>;
    isNew: boolean;
  } | null>(null);

  const [saving, setSaving] = useState(false);

  // Open modal to create a test
  const handleCreateTest = () => {
    setEditingTest({
      id: `new_${Date.now()}`,
      title: '',
      description: '',
      category: 'Загальне',
      timeLimitMinutes: 15,
      passingScorePercent: 80,
      randomQuestionCount: 5,
      maxAttempts: 2,
      cooldownHours: 24,
      isActive: true,
      questions: [],
    });
  };

  const handleSaveTest = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingTest || !editingTest.title) return;

    setSaving(true);
    try {
      await api.saveTest(editingTest);
      setEditingTest(null);
      onRefreshTests();
    } catch (err: any) {
      alert(err.message || 'Помилка збереження тесту');
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteTest = async (testId: string, testTitle: string) => {
    if (!confirm(`Ви дійсно бажаєте видалити іспит "${testTitle}"?`)) return;
    try {
      await api.deleteTest(testId);
      if (selectedTestForBank?.id === testId) setSelectedTestForBank(null);
      onRefreshTests();
    } catch (err: any) {
      alert(err.message || 'Помилка видалення');
    }
  };

  // ================= QUESTIONS MANAGEMENT =================
  const handleOpenAddQuestion = (test: TestConfig) => {
    setEditingQuestion({
      testId: test.id,
      isNew: true,
      question: {
        id: `q_${Date.now()}`,
        type: 'single',
        title: '',
        category: test.category,
        description: '',
        options: ['', '', '', ''],
        correctOption: 0,
        correctOptions: [0],
        maxPoints: 1,
        explanation: '',
      },
    });
  };

  const handleEditQuestion = (test: TestConfig, q: Question) => {
    setEditingQuestion({
      testId: test.id,
      isNew: false,
      question: { ...q, options: q.options ? [...q.options] : [] },
    });
  };

  const handleDeleteQuestion = async (test: TestConfig, qid: string) => {
    if (!confirm('Видалити це питання з банку?')) return;
    const updatedQuestions = test.questions.filter((q) => q.id !== qid);
    const updatedTest = { ...test, questions: updatedQuestions };

    try {
      await api.saveTest(updatedTest);
      onRefreshTests();
      if (selectedTestForBank?.id === test.id) {
        setSelectedTestForBank(updatedTest);
      }
    } catch (err: any) {
      alert(err.message || 'Помилка видалення питання');
    }
  };

  const handleSaveQuestion = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingQuestion || !editingQuestion.question.title) return;

    const currentTest = tests.find((t) => t.id === editingQuestion.testId);
    if (!currentTest) return;

    const q = editingQuestion.question as Question;
    let questionsList = [...currentTest.questions];

    if (editingQuestion.isNew) {
      questionsList.push(q);
    } else {
      questionsList = questionsList.map((item) => (item.id === q.id ? q : item));
    }

    const updatedTest = { ...currentTest, questions: questionsList };

    setSaving(true);
    try {
      await api.saveTest(updatedTest);
      setEditingQuestion(null);
      onRefreshTests();
      if (selectedTestForBank?.id === currentTest.id) {
        setSelectedTestForBank(updatedTest);
      }
    } catch (err: any) {
      alert(err.message || 'Помилка збереження питання');
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="space-y-8">
      {/* Top Banner */}
      <div className="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2 text-xs font-semibold text-amber-400 uppercase tracking-wider mb-1">
            <Lock className="w-3.5 h-3.5" />
            Керування навчальною програмою
          </div>
          <h1 className="text-xl font-bold text-white">
            Банк іспитів, регламенти та питання
          </h1>
          <p className="text-xs text-slate-400 mt-1 max-w-2xl">
            {isLeader
              ? 'Ви маєте повні права лідера фракції: створення і редагування тестів, налаштування лімітів часу, прохідних балів та випадкової вибірки з банку.'
              : 'Режим перегляду інструктора. Для редагування структури тестів перемкніться на акаунт лідера у верхньому правому кутку.'}
          </p>
        </div>

        {isLeader && (
          <button
            onClick={handleCreateTest}
            className="py-2.5 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition-colors shrink-0 shadow-sm shadow-amber-500/20"
          >
            <Plus className="w-4 h-4" />
            Створити новий іспит
          </button>
        )}
      </div>

      {/* Tests Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tests.map((test) => (
          <div
            key={test.id}
            className="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-colors space-y-4"
          >
            <div className="space-y-3">
              <div className="flex items-start justify-between gap-2">
                <span className="text-[11px] font-semibold text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20">
                  {test.category}
                </span>

                <div className="flex items-center gap-1">
                  {isLeader && (
                    <>
                      <button
                        onClick={() => setEditingTest(test)}
                        className="p-1 text-slate-400 hover:text-white transition-colors"
                        title="Змінити налаштування"
                      >
                        <Edit2 className="w-3.5 h-3.5" />
                      </button>
                      <button
                        onClick={() => handleDeleteTest(test.id, test.title)}
                        className="p-1 text-slate-400 hover:text-red-400 transition-colors"
                        title="Видалити іспит"
                      >
                        <Trash2 className="w-3.5 h-3.5" />
                      </button>
                    </>
                  )}
                </div>
              </div>

              <div>
                <h3 className="text-base font-bold text-white line-clamp-1">{test.title}</h3>
                <p className="text-xs text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                  {test.description || 'Немає опису'}
                </p>
              </div>

              {/* Specs */}
              <div className="p-3 rounded-xl bg-slate-950/70 border border-slate-800/80 grid grid-cols-2 gap-2 text-center text-xs">
                <div>
                  <span className="text-[10px] text-slate-500 block">Час на іспит</span>
                  <span className="font-bold text-white tabular-nums">{test.timeLimitMinutes} хв</span>
                </div>
                <div>
                  <span className="text-[10px] text-slate-500 block">Прохідний бал</span>
                  <span className="font-bold text-emerald-400 tabular-nums">
                    {test.passingScorePercent}%
                  </span>
                </div>
                <div>
                  <span className="text-[10px] text-slate-500 block">Вибірка з банку</span>
                  <span className="font-bold text-amber-400 tabular-nums">
                    {test.randomQuestionCount} з {test.questions.length}
                  </span>
                </div>
                <div>
                  <span className="text-[10px] text-slate-500 block">Спроби / Пауза</span>
                  <span className="font-bold text-slate-300 tabular-nums">
                    {test.maxAttempts} сп. / {test.cooldownHours} год
                  </span>
                </div>
              </div>
            </div>

            <button
              onClick={() => setSelectedTestForBank(test)}
              className="w-full py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors border border-slate-700/60"
            >
              <FileQuestion className="w-3.5 h-3.5 text-amber-400" />
              Банк питань ({test.questions.length})
            </button>
          </div>
        ))}
      </div>

      {/* Selected Test Question Bank Section */}
      {selectedTestForBank && (
        <div className="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-6 animate-in fade-in duration-300">
          <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
            <div>
              <div className="text-xs text-amber-400 font-semibold uppercase tracking-wider">
                Банк питань для:
              </div>
              <h2 className="text-xl font-bold text-white">{selectedTestForBank.title}</h2>
              <p className="text-xs text-slate-400 mt-0.5">
                Кадету випадковим чином дістаються <strong>{selectedTestForBank.randomQuestionCount}</strong> питань з доступних {selectedTestForBank.questions.length}.
              </p>
            </div>

            <div className="flex items-center gap-2">
              {isLeader && (
                <button
                  onClick={() => handleOpenAddQuestion(selectedTestForBank)}
                  className="py-2 px-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition-colors shadow-sm"
                >
                  <Plus className="w-4 h-4" />
                  Додати питання до банку
                </button>
              )}
              <button
                onClick={() => setSelectedTestForBank(null)}
                className="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800"
              >
                <X className="w-4 h-4" />
              </button>
            </div>
          </div>

          <div className="space-y-3">
            {selectedTestForBank.questions.length === 0 ? (
              <div className="text-center py-8 text-xs text-slate-500">
                Банк питань порожній. Додайте перше питання.
              </div>
            ) : (
              selectedTestForBank.questions.map((q, idx) => (
                <div
                  key={q.id}
                  className="p-4 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-slate-700 transition-colors space-y-2 text-xs"
                >
                  <div className="flex items-start justify-between gap-3">
                    <div className="flex items-start gap-2">
                      <span className="font-bold text-amber-400 shrink-0 font-mono">#{idx + 1}</span>
                      <div>
                        <div className="font-semibold text-white text-sm">{q.title}</div>
                        {q.description && (
                          <div className="text-slate-400 mt-0.5 text-xs italic">{q.description}</div>
                        )}
                      </div>
                    </div>

                    <div className="flex items-center gap-2 shrink-0">
                      <span className="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300">
                        {q.type === 'single'
                          ? 'Одиночний вибір'
                          : q.type === 'multiple'
                          ? 'Множинний'
                          : 'Відкритий кейс'}
                      </span>
                      <span className="text-amber-400 font-bold font-mono">
                        {q.maxPoints} б.
                      </span>

                      {isLeader && (
                        <div className="flex items-center gap-1 ml-2">
                          <button
                            onClick={() => handleEditQuestion(selectedTestForBank, q)}
                            className="p-1 text-slate-400 hover:text-white"
                          >
                            <Edit2 className="w-3.5 h-3.5" />
                          </button>
                          <button
                            onClick={() => handleDeleteQuestion(selectedTestForBank, q.id)}
                            className="p-1 text-slate-400 hover:text-red-400"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Options summary */}
                  {q.options && q.options.length > 0 && (
                    <div className="pl-6 space-y-1 pt-1 text-[11px] text-slate-400">
                      {q.options.map((opt, oIdx) => {
                        const isCorrect =
                          q.type === 'single'
                            ? q.correctOption === oIdx
                            : (q.correctOptions || []).includes(oIdx);

                        return (
                          <div
                            key={oIdx}
                            className={`flex items-center gap-2 ${
                              isCorrect ? 'text-emerald-400 font-semibold' : ''
                            }`}
                          >
                            <span>{isCorrect ? '✅' : '⚪'}</span>
                            <span>{opt}</span>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  {q.explanation && (
                    <div className="pl-6 pt-1 text-[10px] text-slate-500 italic">
                      Підказка інструктору: {q.explanation}
                    </div>
                  )}
                </div>
              ))
            )}
          </div>
        </div>
      )}

      {/* MODAL 1: Create/Edit Test */}
      {editingTest && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4">
          <form
            onSubmit={handleSaveTest}
            className="max-w-xl w-full p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl space-y-4"
          >
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="text-base font-bold text-white">
                {editingTest.id?.startsWith('new_') ? 'Створення нового іспиту' : 'Редагування іспиту'}
              </h3>
              <button
                type="button"
                onClick={() => setEditingTest(null)}
                className="text-slate-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">
                Назва іспиту <span className="text-amber-400">*</span>
              </label>
              <input
                type="text"
                required
                value={editingTest.title || ''}
                onChange={(e) => setEditingTest({ ...editingTest, title: e.target.value })}
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                placeholder="напр. Теорія: Процесуальний кодекс"
              />
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">Категорія</label>
                <input
                  type="text"
                  value={editingTest.category || ''}
                  onChange={(e) => setEditingTest({ ...editingTest, category: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                  placeholder="Законодавство / Тактика"
                />
              </div>

              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Ліміт часу (хвилини)
                </label>
                <input
                  type="number"
                  min={1}
                  max={120}
                  value={editingTest.timeLimitMinutes || 15}
                  onChange={(e) =>
                    setEditingTest({ ...editingTest, timeLimitMinutes: Number(e.target.value) })
                  }
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">Опис / Регламент</label>
              <textarea
                rows={2}
                value={editingTest.description || ''}
                onChange={(e) => setEditingTest({ ...editingTest, description: e.target.value })}
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                placeholder="Короткий зміст або опис для кадета"
              />
            </div>

            <div className="grid grid-cols-3 gap-3">
              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Прохідний бал (%)
                </label>
                <input
                  type="number"
                  min={1}
                  max={100}
                  value={editingTest.passingScorePercent || 80}
                  onChange={(e) =>
                    setEditingTest({ ...editingTest, passingScorePercent: Number(e.target.value) })
                  }
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Питань у білеті
                </label>
                <input
                  type="number"
                  min={1}
                  value={editingTest.randomQuestionCount || 5}
                  onChange={(e) =>
                    setEditingTest({ ...editingTest, randomQuestionCount: Number(e.target.value) })
                  }
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Ліміт спроб
                </label>
                <input
                  type="number"
                  min={1}
                  max={10}
                  value={editingTest.maxAttempts || 2}
                  onChange={(e) =>
                    setEditingTest({ ...editingTest, maxAttempts: Number(e.target.value) })
                  }
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">
                Пауза між перездачами (годин)
              </label>
              <input
                type="number"
                min={0}
                max={168}
                value={editingTest.cooldownHours || 24}
                onChange={(e) =>
                  setEditingTest({ ...editingTest, cooldownHours: Number(e.target.value) })
                }
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
              />
              <span className="text-[10px] text-slate-500 mt-0.5 block">
                Якщо кадет завалив іспит, система не дозволить згенерувати посилання раніше вказаного часу.
              </span>
            </div>

            <div className="pt-3 flex items-center justify-end gap-2 border-t border-slate-800">
              <button
                type="button"
                onClick={() => setEditingTest(null)}
                className="px-4 py-2 rounded-xl bg-slate-800 text-xs text-slate-300 hover:text-white"
              >
                Скасувати
              </button>
              <button
                type="submit"
                disabled={saving}
                className="px-5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs"
              >
                {saving ? 'Збереження...' : 'Зберегти іспит'}
              </button>
            </div>
          </form>
        </div>
      )}

      {/* MODAL 2: Create/Edit Question */}
      {editingQuestion && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4 overflow-y-auto">
          <form
            onSubmit={handleSaveQuestion}
            className="max-w-2xl w-full my-8 p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto"
          >
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="text-base font-bold text-white">
                {editingQuestion.isNew ? 'Додати питання до банку' : 'Редагувати питання'}
              </h3>
              <button
                type="button"
                onClick={() => setEditingQuestion(null)}
                className="text-slate-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">
                Тип питання <span className="text-amber-400">*</span>
              </label>
              <div className="grid grid-cols-3 gap-2">
                <button
                  type="button"
                  onClick={() =>
                    setEditingQuestion({
                      ...editingQuestion,
                      question: { ...editingQuestion.question, type: 'single' },
                    })
                  }
                  className={`py-2 px-3 rounded-xl border text-xs font-semibold ${
                    editingQuestion.question.type === 'single'
                      ? 'bg-amber-400/20 border-amber-400 text-amber-300'
                      : 'bg-slate-950 border-slate-800 text-slate-400'
                  }`}
                >
                  Одиночний вибір
                </button>
                <button
                  type="button"
                  onClick={() =>
                    setEditingQuestion({
                      ...editingQuestion,
                      question: { ...editingQuestion.question, type: 'multiple' },
                    })
                  }
                  className={`py-2 px-3 rounded-xl border text-xs font-semibold ${
                    editingQuestion.question.type === 'multiple'
                      ? 'bg-amber-400/20 border-amber-400 text-amber-300'
                      : 'bg-slate-950 border-slate-800 text-slate-400'
                  }`}
                >
                  Множинний вибір
                </button>
                <button
                  type="button"
                  onClick={() =>
                    setEditingQuestion({
                      ...editingQuestion,
                      question: { ...editingQuestion.question, type: 'open' },
                    })
                  }
                  className={`py-2 px-3 rounded-xl border text-xs font-semibold ${
                    editingQuestion.question.type === 'open'
                      ? 'bg-amber-400/20 border-amber-400 text-amber-300'
                      : 'bg-slate-950 border-slate-800 text-slate-400'
                  }`}
                >
                  Відкритий кейс
                </button>
              </div>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">
                Текст питання <span className="text-amber-400">*</span>
              </label>
              <input
                type="text"
                required
                value={editingQuestion.question.title || ''}
                onChange={(e) =>
                  setEditingQuestion({
                    ...editingQuestion,
                    question: { ...editingQuestion.question, title: e.target.value },
                  })
                }
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                placeholder="напр. Що означає тен-код 10-4?"
              />
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">
                Додатковий опис / Фабула ситуації (опціонально)
              </label>
              <textarea
                rows={2}
                value={editingQuestion.question.description || ''}
                onChange={(e) =>
                  setEditingQuestion({
                    ...editingQuestion,
                    question: { ...editingQuestion.question, description: e.target.value },
                  })
                }
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                placeholder="Для відкритих кейсів: детальний опис обставин інциденту..."
              />
            </div>

            {/* If Single or Multiple: Edit Options */}
            {editingQuestion.question.type !== 'open' && (
              <div className="space-y-3 pt-2">
                <div className="flex items-center justify-between">
                  <label className="text-xs font-semibold text-slate-300">
                    Варіанти відповідей (позначте правильні):
                  </label>
                  <button
                    type="button"
                    onClick={() => {
                      const opts = editingQuestion.question.options || [];
                      setEditingQuestion({
                        ...editingQuestion,
                        question: { ...editingQuestion.question, options: [...opts, ''] },
                      });
                    }}
                    className="text-xs text-amber-400 hover:text-amber-300 font-medium"
                  >
                    + Додати варіант
                  </button>
                </div>

                <div className="space-y-2">
                  {(editingQuestion.question.options || []).map((opt, oIdx) => {
                    const isSingle = editingQuestion.question.type === 'single';
                    const isCorrect = isSingle
                      ? editingQuestion.question.correctOption === oIdx
                      : (editingQuestion.question.correctOptions || []).includes(oIdx);

                    return (
                      <div key={oIdx} className="flex items-center gap-2">
                        <input
                          type={isSingle ? 'radio' : 'checkbox'}
                          name="correctOptionRadio"
                          checked={isCorrect}
                          onChange={() => {
                            if (isSingle) {
                              setEditingQuestion({
                                ...editingQuestion,
                                question: { ...editingQuestion.question, correctOption: oIdx },
                              });
                            } else {
                              const curr = editingQuestion.question.correctOptions || [];
                              const next = curr.includes(oIdx)
                                ? curr.filter((i) => i !== oIdx)
                                : [...curr, oIdx];
                              setEditingQuestion({
                                ...editingQuestion,
                                question: { ...editingQuestion.question, correctOptions: next },
                              });
                            }
                          }}
                          className="w-4 h-4 accent-amber-400 shrink-0"
                          title="Позначити як правильну відповідь"
                        />
                        <input
                          type="text"
                          required
                          value={opt}
                          onChange={(e) => {
                            const newOpts = [...(editingQuestion.question.options || [])];
                            newOpts[oIdx] = e.target.value;
                            setEditingQuestion({
                              ...editingQuestion,
                              question: { ...editingQuestion.question, options: newOpts },
                            });
                          }}
                          className="flex-1 px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
                          placeholder={`Варіант ${oIdx + 1}`}
                        />
                        {(editingQuestion.question.options || []).length > 2 && (
                          <button
                            type="button"
                            onClick={() => {
                              const newOpts = (editingQuestion.question.options || []).filter(
                                (_, idx) => idx !== oIdx
                              );
                              setEditingQuestion({
                                ...editingQuestion,
                                question: { ...editingQuestion.question, options: newOpts },
                              });
                            }}
                            className="p-1 text-slate-500 hover:text-red-400"
                          >
                            <X className="w-3.5 h-3.5" />
                          </button>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            <div className="grid grid-cols-2 gap-3 pt-2">
              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Максимальні бали за відповідь
                </label>
                <input
                  type="number"
                  min={1}
                  max={10}
                  value={editingQuestion.question.maxPoints || 1}
                  onChange={(e) =>
                    setEditingQuestion({
                      ...editingQuestion,
                      question: { ...editingQuestion.question, maxPoints: Number(e.target.value) },
                    })
                  }
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">Категорія</label>
                <input
                  type="text"
                  value={editingQuestion.question.category || ''}
                  onChange={(e) =>
                    setEditingQuestion({
                      ...editingQuestion,
                      question: { ...editingQuestion.question, category: e.target.value },
                    })
                  }
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                  placeholder="напр. Тен-коди"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">
                Пояснення / Критерії для інструктора
              </label>
              <textarea
                rows={2}
                value={editingQuestion.question.explanation || ''}
                onChange={(e) =>
                  setEditingQuestion({
                    ...editingQuestion,
                    question: { ...editingQuestion.question, explanation: e.target.value },
                  })
                }
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-amber-500"
                placeholder="Посилання на статтю закону або критерії оцінювання відкритого кейсу"
              />
            </div>

            <div className="pt-3 flex items-center justify-end gap-2 border-t border-slate-800">
              <button
                type="button"
                onClick={() => setEditingQuestion(null)}
                className="px-4 py-2 rounded-xl bg-slate-800 text-xs text-slate-300 hover:text-white"
              >
                Скасувати
              </button>
              <button
                type="submit"
                disabled={saving}
                className="px-5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs"
              >
                {saving ? 'Збереження...' : 'Зберегти питання'}
              </button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
};
