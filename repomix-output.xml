<file path="src/components/DiscordAuthModal.tsx">
import React, { useState, useEffect } from 'react';
import {
  X,
  Shield,
  CheckCircle2,
  AlertTriangle,
  ExternalLink,
  LogIn,
  LogOut,
  Sparkles,
  Key,
  Layers,
  Radio,
} from 'lucide-react';
import { User, AppSettings } from '../types';
import { api } from '../services/api';

interface DiscordAuthModalProps {
  isOpen: boolean;
  onClose: () => void;
  currentUser: User | null;
  settings: AppSettings | null;
  onUserChanged: (user: User) => void;
}

export const DiscordAuthModal: React.FC<DiscordAuthModalProps> = ({
  isOpen,
  onClose,
  currentUser,
  settings,
  onUserChanged,
}) => {
  const [activeTab, setActiveTab] = useState<'oauth' | 'direct'>('oauth');

  // OAuth states
  const [oauthLoading, setOauthLoading] = useState(false);
  const [oauthError, setOauthError] = useState<string | null>(null);

  // Direct login states
  const [discordId, setDiscordId] = useState(currentUser?.discordId || '');
  const [discordUsername, setDiscordUsername] = useState(currentUser?.discordUsername || '');
  const [name, setName] = useState(currentUser?.name || '');
  const [staticId, setStaticId] = useState(currentUser?.staticId || '');
  const [selectedRole, setSelectedRole] = useState<'leader' | 'instructor'>(
    currentUser?.role === 'leader' ? 'leader' : 'instructor'
  );
  const [submittingDirect, setSubmittingDirect] = useState(false);
  const [directError, setDirectError] = useState<string | null>(null);

  // Listen for popup postMessage according to oauth-integration skill
  useEffect(() => {
    const handleMessage = (event: MessageEvent) => {
      const origin = event.origin;
      
      // Дозволяємо поточний домен (Netlify), а також локальні хости
      const isAllowedOrigin =
        origin === window.location.origin ||
        origin.endsWith('.netlify.app') ||
        origin.endsWith('.run.app') ||
        origin.includes('localhost') ||
        origin.includes('127.0.0.1');

      if (!isAllowedOrigin) {
        return;
      }

      if (event.data?.type === 'OAUTH_AUTH_SUCCESS') {
        const authedUser = event.data.user;
        if (authedUser) {
          onUserChanged(authedUser);
          onClose();
        }
      }
    };

    window.addEventListener('message', handleMessage);
    return () => window.removeEventListener('message', handleMessage);
  }, [onUserChanged, onClose]);

  if (!isOpen) return null;

  const handleStartOAuth = async () => {
    setOauthLoading(true);
    setOauthError(null);
    try {
      const { url } = await api.getDiscordAuthUrl();
      const authWindow = window.open(
        url,
        'discord_oauth_popup',
        'width=600,height=750,menubar=no,toolbar=no'
      );

      if (!authWindow) {
        setOauthError('Спливаюче вікно заблоковано браузером. Будь ласка, дозвольте pop-up для цього сайту.');
      }
    } catch (err: any) {
      setOauthError(err.message || 'Не вдалося ініціювати вхід через Discord');
    } finally {
      setOauthLoading(false);
    }
  };

  const handleDirectLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!discordId.trim()) {
      setDirectError('Вкажіть ваш Discord ID');
      return;
    }

    setSubmittingDirect(true);
    setDirectError(null);
    try {
      const res = await api.directDiscordLogin({
        discordId: discordId.trim(),
        discordUsername: discordUsername.trim() || undefined,
        role: selectedRole,
        name: name.trim() || undefined,
        staticId: staticId.trim() || undefined,
      });

      onUserChanged(res.user);
      onClose();
    } catch (err: any) {
      setDirectError(err.message || 'Помилка авторизації');
    } finally {
      setSubmittingDirect(false);
    }
  };

  const handleLogout = async () => {
    try {
      const res = await api.logout();
      onUserChanged(res.user);
      onClose();
    } catch (err: any) {
      alert(err.message || 'Помилка виходу');
    }
  };

  const leaderTitle = settings?.roleTitles?.leader || 'Лідер фракції';
  const instructorTitle = settings?.roleTitles?.instructor || 'Інструктор Академії';

  return (
    <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
      <div className="max-w-md w-full bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
        {/* Header */}
        <div className="p-5 bg-slate-950 border-b border-slate-800 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
              <Shield className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-base font-bold text-white">Авторизація через Discord</h3>
              <p className="text-xs text-slate-400">Вхід за ролями фракційного сервера</p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Current User Card */}
        {currentUser && (
          <div className="px-5 py-3 bg-slate-950/60 border-b border-slate-800 flex items-center justify-between text-xs">
            <div className="flex items-center gap-2.5">
              <div className="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-white overflow-hidden">
                {currentUser.discordAvatar ? (
                  <img
                    src={currentUser.discordAvatar}
                    alt={currentUser.name}
                    className="w-full h-full object-cover"
                  />
                ) : (
                  currentUser.name[0]?.toUpperCase() || 'U'
                )}
              </div>
              <div>
                <div className="font-semibold text-white flex items-center gap-1.5">
                  <span>{currentUser.name}</span>
                  <span className="text-[10px] text-slate-400 font-mono">({currentUser.staticId || '#ID'})</span>
                </div>
                <div className="text-[10px] text-amber-400 font-medium">
                  {currentUser.role === 'leader' ? `👑 ${leaderTitle}` : `🎓 ${instructorTitle}`}
                  {currentUser.discordId && ` · @${currentUser.discordId}`}
                </div>
              </div>
            </div>

            <button
              onClick={handleLogout}
              className="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-red-500/20 text-slate-400 hover:text-red-300 transition-colors text-[11px] font-semibold flex items-center gap-1"
              title="Вийти з акаунта"
            >
              <LogOut className="w-3 h-3" />
              <span>Змінити</span>
            </button>
          </div>
        )}

        {/* Mode Selector Tabs */}
        <div className="flex border-b border-slate-800 bg-slate-950/40 text-xs font-semibold">
          <button
            onClick={() => setActiveTab('oauth')}
            className={`flex-1 py-3 text-center transition-colors border-b-2 ${
              activeTab === 'oauth'
                ? 'border-indigo-500 text-indigo-400 bg-indigo-500/5'
                : 'border-transparent text-slate-400 hover:text-slate-200'
            }`}
          >
            Вхід через Discord OAuth
          </button>
          <button
            onClick={() => setActiveTab('direct')}
            className={`flex-1 py-3 text-center transition-colors border-b-2 ${
              activeTab === 'direct'
                ? 'border-amber-500 text-amber-400 bg-amber-500/5'
                : 'border-transparent text-slate-400 hover:text-slate-200'
            }`}
          >
            Вхід за Discord ID / Тест
          </button>
        </div>

        {/* Tab 1: OAuth2 Flow */}
        {activeTab === 'oauth' && (
          <div className="p-6 space-y-4">
            <div className="text-xs text-slate-300 leading-relaxed">
              Авторизуйтесь через свій обліковий запис Discord. Система автоматично перевірить ваші ролі на сервері фракції (
              <strong>{settings?.academyName || 'Академія'}</strong>) та надасть доступ відповідно до ваших обов'язків:
            </div>

            <div className="space-y-2 text-xs">
              <div className="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-2.5">
                <span className="text-amber-400 font-bold">👑</span>
                <div>
                  <div className="font-bold text-white">{leaderTitle}</div>
                  <div className="text-[11px] text-slate-400">
                    Повний доступ: керування Discord Webhook, створення тестів, редагування ролей та інструкторів.
                  </div>
                </div>
              </div>

              <div className="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-2.5">
                <span className="text-indigo-400 font-bold">🎓</span>
                <div>
                  <div className="font-bold text-white">{instructorTitle}</div>
                  <div className="text-[11px] text-slate-400">
                    Доступ до видачі одноразових посилань кадетам, перевірки та винесення вердиктів.
                  </div>
                </div>
              </div>
            </div>

            {oauthError && (
              <div className="p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs">
                {oauthError}
              </div>
            )}

            <button
              type="button"
              onClick={handleStartOAuth}
              disabled={oauthLoading}
              className="w-full py-3 px-4 rounded-xl bg-[#5865F2] hover:bg-[#4752c4] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg shadow-[#5865F2]/20 transition-all disabled:opacity-50"
            >
              <LogIn className="w-4 h-4" />
              <span>{oauthLoading ? 'Відкриття вікна...' : 'Увійти з Discord'}</span>
            </button>

            {!settings?.discordClientId && (
              <div className="text-[11px] text-slate-500 text-center">
                💡 Якщо Discord Client ID ще не налаштовано лідером, скористайтеся вкладкою <strong>«Вхід за Discord ID / Тест»</strong>.
              </div>
            )}
          </div>
        )}

        {/* Tab 2: Direct Discord ID / Simulator */}
        {activeTab === 'direct' && (
          <form onSubmit={handleDirectLogin} className="p-6 space-y-4">
            <div className="text-xs text-slate-300">
              Введіть ваш Discord ID або оберіть роль для миттєвого тестування чи роботи інструктора:
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Discord ID (або нікнейм): <span className="text-red-400">*</span>
              </label>
              <input
                type="text"
                placeholder="напр. 384918274019283741 або koval_leader"
                value={discordId}
                onChange={(e) => setDiscordId(e.target.value)}
                required
                className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-500"
              />
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1">
                  Ім'я / Позивний:
                </label>
                <input
                  type="text"
                  placeholder="Олександр Коваль"
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-500"
                />
              </div>
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1">
                  Статік (#ID):
                </label>
                <input
                  type="text"
                  placeholder="#1001"
                  value={staticId}
                  onChange={(e) => setStaticId(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-500"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1.5">
                Роль у системі:
              </label>
              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={() => setSelectedRole('leader')}
                  className={`p-2.5 rounded-xl border text-xs font-bold flex items-center justify-center gap-1.5 transition-all ${
                    selectedRole === 'leader'
                      ? 'bg-amber-500/20 border-amber-500 text-amber-300'
                      : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
                  }`}
                >
                  <span>👑</span>
                  <span>{leaderTitle}</span>
                </button>

                <button
                  type="button"
                  onClick={() => setSelectedRole('instructor')}
                  className={`p-2.5 rounded-xl border text-xs font-bold flex items-center justify-center gap-1.5 transition-all ${
                    selectedRole === 'instructor'
                      ? 'bg-indigo-500/20 border-indigo-500 text-indigo-300'
                      : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
                  }`}
                >
                  <span>🎓</span>
                  <span>{instructorTitle}</span>
                </button>
              </div>
            </div>

            {directError && (
              <div className="p-2.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs">
                {directError}
              </div>
            )}

            <button
              type="submit"
              disabled={submittingDirect}
              className="w-full py-2.5 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-amber-500/20 disabled:opacity-50"
            >
              <LogIn className="w-4 h-4" />
              <span>{submittingDirect ? 'Авторизація...' : 'Підтвердити вхід'}</span>
            </button>
          </form>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/InstructorPanel.tsx">
import React, { useState, useEffect } from 'react';
import { Send, Copy, Check, ExternalLink, AlertTriangle, Clock, Award, ShieldAlert, Sparkles, RefreshCw } from 'lucide-react';
import { TestConfig, ExamToken } from '../types';
import { api } from '../services/api';

interface InstructorPanelProps {
  tests: TestConfig[];
  onOpenExamAsCadet: (token: string) => void;
}

export const InstructorPanel: React.FC<InstructorPanelProps> = ({ tests, onOpenExamAsCadet }) => {
  const [cadetNickname, setCadetNickname] = useState('');
  const [cadetStatic, setCadetStatic] = useState('');
  const [cadetDiscord, setCadetDiscord] = useState('');
  const [selectedTestId, setSelectedTestId] = useState<string>('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [generatedResult, setGeneratedResult] = useState<{
    token: ExamToken;
    examLink: string;
    discordCopyTemplate: string;
  } | null>(null);

  const [copiedLink, setCopiedLink] = useState(false);
  const [copiedTemplate, setCopiedTemplate] = useState(false);
  const [tokens, setTokens] = useState<ExamToken[]>([]);
  const [refreshingTokens, setRefreshingTokens] = useState(false);

  useEffect(() => {
    if (tests.length > 0 && !selectedTestId) {
      setSelectedTestId(tests[0].id);
    }
  }, [tests, selectedTestId]);

  const loadTokens = async () => {
    try {
      setRefreshingTokens(true);
      const list = await api.getTokens();
      setTokens(list);
    } catch (e) {
      console.error(e);
    } finally {
      setRefreshingTokens(false);
    }
  };

  useEffect(() => {
    loadTokens();
  }, []);

  const selectedTest = tests.find((t) => t.id === selectedTestId);

  const handleGenerate = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setGeneratedResult(null);

    if (!cadetNickname.trim() || !cadetStatic.trim() || !selectedTestId) {
      setError('Заповніть нікнейм, статік та оберіть іспит');
      return;
    }

    setLoading(true);
    try {
      const data = await api.generateExamLink({
        cadetNickname: cadetNickname.trim(),
        cadetStatic: cadetStatic.trim(),
        cadetDiscord: cadetDiscord.trim(),
        testId: selectedTestId,
      });
      setGeneratedResult(data);
      loadTokens();
    } catch (err: any) {
      setError(err.message || 'Помилка генерації посилання');
    } finally {
      setLoading(false);
    }
  };

  const copyToClipboard = async (text: string, isTemplate: boolean) => {
    try {
      await navigator.clipboard.writeText(text);
      if (isTemplate) {
        setCopiedTemplate(true);
        setTimeout(() => setCopiedTemplate(false), 2000);
      } else {
        setCopiedLink(true);
        setTimeout(() => setCopiedLink(false), 2000);
      }
    } catch (err) {
      console.error('Clipboard copy error', err);
    }
  };

  const fillQuickDemo = (name: string, staticId: string, discord: string) => {
    setCadetNickname(name);
    setCadetStatic(staticId);
    setCadetDiscord(discord);
  };

  return (
    <div className="space-y-8">
      {/* Top Description Banner */}
      <div className="p-6 rounded-2xl bg-gradient-to-r from-slate-900 via-slate-900 to-slate-800/80 border border-slate-800 relative overflow-hidden">
        <div className="relative z-10 max-w-3xl">
          <div className="inline-flex items-center gap-2 text-xs font-semibold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2.5 py-1 rounded-md mb-3">
            <Sparkles className="w-3.5 h-3.5" />
            Автоматизована видача іспитів
          </div>
          <h1 className="text-2xl font-bold tracking-tight text-white mb-2">
            Генерація персонального одноразового посилання
          </h1>
          <p className="text-sm text-slate-400 leading-relaxed">
            Коли кадет пише в Discord про готовність скласти іспит, введіть його дані нижче. Система перевірить ліміт спроб і паузу між перездачами, збереже правильні відповіді виключно на сервері та створить захищений токен.
          </p>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start min-w-0">
        {/* Left Column: Generator Form (7 cols) */}
        <div className="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-sm min-w-0 w-full">
          <form onSubmit={handleGenerate} className="space-y-6 min-w-0">
            <div className="flex items-center justify-between pb-4 border-b border-slate-800">
              <h2 className="text-base font-semibold text-white flex items-center gap-2">
                <Send className="w-4 h-4 text-amber-400" />
                Дані кадета та вибір тесту
              </h2>
              <div className="text-xs text-slate-400">
                Швидкий ввід:
                <button
                  type="button"
                  onClick={() => fillQuickDemo('Roman_Danyliuk', '#19482', 'danyliuk_cadet')}
                  className="ml-2 text-amber-400 hover:text-amber-300 underline font-mono"
                >
                  Кадет Данилюк
                </button>
              </div>
            </div>

            {error && (
              <div className="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-300 text-sm flex items-start gap-3">
                <AlertTriangle className="w-5 h-5 text-red-400 shrink-0 mt-0.5" />
                <div>
                  <div className="font-semibold text-red-200">Помилка видачі іспиту</div>
                  <div className="text-xs text-red-300/90 mt-0.5 leading-relaxed">{error}</div>
                </div>
              </div>
            )}

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1.5">
                  Нікнейм кадета (Ім'я_Прізвище) <span className="text-amber-400">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="напр. Alex_Mason"
                  value={cadetNickname}
                  onChange={(e) => setCadetNickname(e.target.value)}
                  className="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors"
                />
              </div>

              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1.5">
                  Статік кадета (ID в штаті) <span className="text-amber-400">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="напр. #14285"
                  value={cadetStatic}
                  onChange={(e) => setCadetStatic(e.target.value)}
                  className="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors font-mono"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1.5">
                Discord ID або тег кадета (для сповіщення у гілці)
              </label>
              <input
                type="text"
                placeholder="напр. 392817482910293847 або @alex_mason"
                value={cadetDiscord}
                onChange={(e) => setCadetDiscord(e.target.value)}
                className="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors font-mono"
              />
              <span className="text-[11px] text-slate-500 mt-1 block">
                Якщо вказати числовий Discord ID, кадет отримає пряме згадування &lt;@ID&gt; у каналі після завершення іспиту.
              </span>
            </div>

            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1.5">
                Оберіть дисципліну / іспит <span className="text-amber-400">*</span>
              </label>
              <select
                value={selectedTestId}
                onChange={(e) => setSelectedTestId(e.target.value)}
                className="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
              >
                {tests.map((t) => (
                  <option key={t.id} value={t.id}>
                    {t.title} ({t.category}) · {t.timeLimitMinutes} хв
                  </option>
                ))}
              </select>
            </div>

            {selectedTest && (
              <div className="p-4 rounded-xl bg-slate-950/70 border border-slate-800/80 space-y-3">
                <div className="text-xs font-medium text-slate-400 uppercase tracking-wider">
                  Параметри обраного тесту
                </div>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                  <div className="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
                    <Clock className="w-4 h-4 text-amber-400 mx-auto mb-1" />
                    <div className="text-xs font-bold text-white tabular-nums">{selectedTest.timeLimitMinutes} хв</div>
                    <div className="text-[10px] text-slate-400">Ліміт часу</div>
                  </div>
                  <div className="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
                    <Award className="w-4 h-4 text-emerald-400 mx-auto mb-1" />
                    <div className="text-xs font-bold text-white tabular-nums">{selectedTest.passingScorePercent}%</div>
                    <div className="text-[10px] text-slate-400">Прохідний бал</div>
                  </div>
                  <div className="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
                    <RefreshCw className="w-4 h-4 text-blue-400 mx-auto mb-1" />
                    <div className="text-xs font-bold text-white tabular-nums">{selectedTest.maxAttempts} спроби</div>
                    <div className="text-[10px] text-slate-400">Макс. спроб</div>
                  </div>
                  <div className="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
                    <ShieldAlert className="w-4 h-4 text-purple-400 mx-auto mb-1" />
                    <div className="text-xs font-bold text-white tabular-nums">{selectedTest.cooldownHours} год</div>
                    <div className="text-[10px] text-slate-400">Пауза перездачі</div>
                  </div>
                </div>
                <div className="text-[11px] text-slate-400 italic">
                  Вибірка: {selectedTest.randomQuestionCount} випадкових питань з банку ({selectedTest.questions.length} доступно). Порядок питань та відповідей перемішується для кожного кадета.
                </div>
              </div>
            )}

            <button
              type="submit"
              disabled={loading}
              className="w-full py-3 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-sm transition-all shadow-md shadow-amber-500/20 flex items-center justify-center gap-2 disabled:opacity-50"
            >
              <Send className="w-4 h-4" />
              {loading ? 'Перевірка лімітів та генерація...' : 'Створити одноразове посилання'}
            </button>
          </form>

          {/* Result Card */}
          {generatedResult && (
            <div className="mt-6 p-5 rounded-2xl bg-amber-500/5 border border-amber-500/30 space-y-4 animate-in fade-in duration-300 min-w-0">
              <div className="flex items-center justify-between">
                <span className="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
                  <Check className="w-4 h-4" />
                  Посилання успішно згенеровано!
                </span>
                <span className="text-[11px] text-slate-400 font-mono">
                  Дійсне 24 години (1 спроба)
                </span>
              </div>

              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Пряме посилання для кадета:
                </label>
                <div className="flex items-center gap-2 min-w-0">
                  <input
                    type="text"
                    readOnly
                    value={generatedResult.examLink}
                    className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-amber-300 font-mono select-all truncate"
                  />
                  <button
                    type="button"
                    onClick={() => copyToClipboard(generatedResult.examLink, false)}
                    className="px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-white font-medium flex items-center gap-1.5 transition-colors shrink-0"
                  >
                    {copiedLink ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                    {copiedLink ? 'Скопійовано' : 'Копіювати'}
                  </button>
                </div>
              </div>

              <div>
                <div className="flex items-center justify-between mb-1">
                  <label className="text-xs font-medium text-slate-300">
                    Готове повідомлення для надсилання в Discord:
                  </label>
                  <button
                    type="button"
                    onClick={() => copyToClipboard(generatedResult.discordCopyTemplate, true)}
                    className="text-xs text-amber-400 hover:text-amber-300 font-medium flex items-center gap-1 shrink-0"
                  >
                    {copiedTemplate ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                    {copiedTemplate ? 'Скопійовано!' : 'Скопіювати для Discord'}
                  </button>
                </div>
                <pre className="p-3 rounded-lg bg-slate-950 border border-slate-800/80 text-[11px] text-slate-300 whitespace-pre-wrap font-sans leading-relaxed break-all max-h-48 overflow-y-auto">
                  {generatedResult.discordCopyTemplate}
                </pre>
              </div>

              <div className="pt-2 flex items-center gap-3">
                <button
                  type="button"
                  onClick={() => onOpenExamAsCadet(generatedResult.token.token)}
                  className="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-xs flex items-center justify-center gap-2 border border-slate-700 transition-colors"
                >
                  <ExternalLink className="w-3.5 h-3.5 text-amber-400" />
                  Відкрити іспит як кадет (Тестове проходження)
                </button>
              </div>
            </div>
          )}
        </div>

        {/* Right Column: Recent Tokens & Live Status (5 cols) */}
        <div className="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4 min-w-0 w-full">
          <div className="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <h3 className="text-sm font-semibold text-white">Видані посилання</h3>
              <p className="text-[11px] text-slate-400">Останні згенеровані токени</p>
            </div>
            <button
              onClick={loadTokens}
              className="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
              title="Оновити список"
            >
              <RefreshCw className={`w-4 h-4 ${refreshingTokens ? 'animate-spin' : ''}`} />
            </button>
          </div>

          <div className="space-y-3 max-h-[540px] overflow-y-auto pr-1">
            {tokens.length === 0 ? (
              <div className="text-center py-8 text-xs text-slate-500">
                Ще не видано жодного посилання.
              </div>
            ) : (
              tokens.slice(0, 8).map((tok) => {
                const isPending = tok.status === 'pending';
                const isInProgress = tok.status === 'in_progress';
                const isSubmitted = tok.status === 'submitted';
                const isExpired = tok.status === 'expired';

                return (
                  <div
                    key={tok.id}
                    className="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 hover:border-slate-700 transition-colors space-y-2"
                  >
                    <div className="flex items-start justify-between gap-2">
                      <div>
                        <div className="text-xs font-semibold text-white">
                          {tok.cadetNickname}
                          <span className="text-[11px] font-mono text-slate-400 ml-1.5">
                            {tok.cadetStatic}
                          </span>
                        </div>
                        <div className="text-[11px] text-slate-400 truncate max-w-[200px]">
                          {tok.testTitle}
                        </div>
                      </div>

                      <div className="text-right shrink-0">
                        {isPending && (
                          <span className="inline-block px-2 py-0.5 rounded text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                            Очікує кадета
                          </span>
                        )}
                        {isInProgress && (
                          <span className="inline-block px-2 py-0.5 rounded text-[10px] font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                            Складає зараз
                          </span>
                        )}
                        {isSubmitted && (
                          <span className="inline-block px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                            Здано
                          </span>
                        )}
                        {isExpired && (
                          <span className="inline-block px-2 py-0.5 rounded text-[10px] font-medium bg-slate-800 text-slate-500">
                            Прострочено
                          </span>
                        )}
                      </div>
                    </div>

                    <div className="flex items-center justify-between text-[10px] text-slate-500 pt-1 border-t border-slate-800/50">
                      <span>Інструктор: {tok.instructorName}</span>
                      <div className="flex items-center gap-2">
                        {!isSubmitted && !isExpired && (
                          <button
                            onClick={() => onOpenExamAsCadet(tok.token)}
                            className="text-amber-400 hover:text-amber-300 font-medium"
                          >
                            Відкрити
                          </button>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/components/ResultReviewModal.tsx">
import React, { useState, useEffect } from 'react';
import {
  X,
  CheckCircle2,
  XCircle,
  Clock,
  ShieldAlert,
  Send,
  RotateCcw,
  MessageSquare,
  FileText,
  AlertTriangle,
  Award,
  Sparkles,
  ExternalLink,
} from 'lucide-react';
import { ExamResult } from '../types';
import { api } from '../services/api';

interface ResultReviewModalProps {
  resultId: string;
  onClose: () => void;
  onUpdated: () => void;
}

export const ResultReviewModal: React.FC<ResultReviewModalProps> = ({
  resultId,
  onClose,
  onUpdated,
}) => {
  const [data, setData] = useState<any | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Open questions manual grades state: { [qid]: { score: number, comment: string } }
  const [openGrades, setOpenGrades] = useState<Record<string, { score: number; comment: string }>>({});
  const [savingGrades, setSavingGrades] = useState(false);

  // Verdict state
  const [decision, setDecision] = useState<'passed' | 'failed' | 'retake_allowed'>('passed');
  const [decisionComment, setDecisionComment] = useState('');
  const [discordThreadId, setDiscordThreadId] = useState('');
  const [submittingDecision, setSubmittingDecision] = useState(false);
  const [discordNotice, setDiscordNotice] = useState<string | null>(null);

  const loadData = async () => {
    try {
      setLoading(true);
      const res = await api.getResultDetail(resultId);
      setData(res);
      setDiscordThreadId(res.discordThreadId || '');

      // Pre-fill open grades
      const initialGrades: Record<string, { score: number; comment: string }> = {};
      res.answers.forEach((a: any) => {
        if (a.type === 'open') {
          initialGrades[a.questionId] = {
            score: a.manualScore || 0,
            comment: a.instructorComment || '',
          };
        }
      });
      setOpenGrades(initialGrades);

      if (res.instructorDecision) {
        setDecision(res.instructorDecision.decision);
        setDecisionComment(res.instructorDecision.comment || '');
      } else {
        // Auto default decision based on score
        setDecision(res.percentage >= (res.test?.passingScorePercent || 80) ? 'passed' : 'failed');
      }
    } catch (err: any) {
      setError(err.message || 'Не вдалося завантажити результат');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, [resultId]);

  const handleGradeChange = (qid: string, score: number) => {
    setOpenGrades((prev) => ({
      ...prev,
      [qid]: {
        ...prev[qid],
        score,
      },
    }));
  };

  const handleCommentChange = (qid: string, comment: string) => {
    setOpenGrades((prev) => ({
      ...prev,
      [qid]: {
        ...prev[qid],
        comment,
      },
    }));
  };

  const handleSaveOpenGrades = async () => {
    setSavingGrades(true);
    try {
      const gradesPayload = Object.entries(openGrades).map(([qid, val]) => ({
        questionId: qid,
        manualScore: val.score,
        instructorComment: val.comment,
      }));

      const res = await api.gradeOpenQuestions(resultId, gradesPayload);
      setData((prev: any) => ({
        ...prev,
        ...res.result,
      }));
      setDiscordNotice('Оцінки за відкриті запитання збережено!');
      setTimeout(() => setDiscordNotice(null), 3000);
      onUpdated();
    } catch (err: any) {
      alert(err.message || 'Помилка збереження оцінок');
    } finally {
      setSavingGrades(false);
    }
  };

  const handleSubmitDecision = async () => {
    setSubmittingDecision(true);
    try {
      const res = await api.submitDecision(resultId, decision, decisionComment, discordThreadId.trim());
      if (res.discordSent === false && res.discordError) {
        setDiscordNotice(`Вердикт збережено, але виникла помилка в Discord: ${res.discordError}`);
        setTimeout(() => {
          onUpdated();
        }, 3000);
      } else {
        setDiscordNotice('Вердикт винесено та успішно надіслано в Discord гілку кадета!');
        setTimeout(() => {
          onUpdated();
          onClose();
        }, 1500);
      }
    } catch (err: any) {
      alert(err.message || 'Помилка публікації вердикту');
    } finally {
      setSubmittingDecision(false);
    }
  };

  if (loading) {
    return (
      <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4">
        <div className="p-8 rounded-2xl bg-slate-900 border border-slate-800 text-center space-y-4">
          <div className="w-10 h-10 border-4 border-amber-400 border-t-transparent rounded-full animate-spin mx-auto" />
          <div className="text-sm text-slate-300">Завантаження картки іспиту...</div>
        </div>
      </div>
    );
  }

  if (error || !data) {
    return (
      <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4">
        <div className="max-w-md w-full p-6 rounded-2xl bg-slate-900 border border-slate-800 text-center space-y-4">
          <XCircle className="w-10 h-10 text-red-400 mx-auto" />
          <div className="text-sm text-white font-medium">{error || 'Результат не знайдено'}</div>
          <button
            onClick={onClose}
            className="w-full py-2 rounded-xl bg-slate-800 text-xs text-white"
          >
            Закрити
          </button>
        </div>
      </div>
    );
  }

  const minutes = Math.floor(data.timeSpentSeconds / 60);
  const seconds = data.timeSpentSeconds % 60;
  const closedAnswers = data.answers.filter((a: any) => a.type !== 'open');
  const openAnswers = data.answers.filter((a: any) => a.type === 'open');

  return (
    <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur flex items-center justify-center p-4 overflow-y-auto">
      <div className="max-w-4xl w-full my-8 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        {/* Header */}
        <div className="p-6 bg-slate-950 border-b border-slate-800 flex items-start justify-between gap-4 shrink-0">
          <div>
            <div className="flex items-center gap-2 mb-1">
              <span className="text-xs font-bold text-amber-400 uppercase tracking-wider">
                Картка перевірки іспиту
              </span>
              <span className="text-slate-600">·</span>
              <span className="text-xs text-slate-400 font-mono">ID: {data.id}</span>
            </div>
            <h2 className="text-xl font-bold text-white">{data.testTitle}</h2>
            <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-300 mt-2 font-mono">
              <span>
                Кадет: <strong className="text-white">{data.cadetNickname}</strong> ({data.cadetStatic})
              </span>
              <span>Discord: {data.cadetDiscord ? `<@${data.cadetDiscord}>` : 'не вказано'}</span>
              <span>
                Час: {minutes} хв {seconds} с
              </span>
            </div>
          </div>

          <button
            onClick={onClose}
            className="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Scrollable Content */}
        <div className="p-6 overflow-y-auto space-y-6 flex-1 text-slate-200">
          {discordNotice && (
            <div className="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-semibold flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
              <span>{discordNotice}</span>
            </div>
          )}

          {/* Score Summary Box */}
          <div className="p-4 rounded-xl bg-slate-950 border border-slate-800 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div>
              <div className="text-[10px] text-slate-400 uppercase font-medium">Закриті тести</div>
              <div className="text-lg font-bold text-white tabular-nums mt-0.5">
                {data.autoScore} / {data.maxAutoScore} б.
              </div>
            </div>
            <div>
              <div className="text-[10px] text-slate-400 uppercase font-medium">Відкриті кейси</div>
              <div className="text-lg font-bold text-amber-400 tabular-nums mt-0.5">
                {data.manualScore} / {data.maxManualScore} б.
              </div>
            </div>
            <div>
              <div className="text-[10px] text-slate-400 uppercase font-medium">Загальний бал</div>
              <div className="text-lg font-bold text-emerald-400 tabular-nums mt-0.5">
                {data.totalScore} / {data.maxTotalScore} б.
              </div>
            </div>
            <div>
              <div className="text-[10px] text-slate-400 uppercase font-medium">Відсоток</div>
              <div className="text-lg font-bold text-white tabular-nums mt-0.5">
                {data.percentage}% (Поріг: {data.test?.passingScorePercent || 80}%)
              </div>
            </div>
          </div>

          {/* Anti-cheat audit box */}
          <div className="p-4 rounded-xl bg-slate-950/80 border border-slate-800 space-y-2">
            <div className="flex items-center justify-between">
              <span className="text-xs font-bold text-amber-400 flex items-center gap-1.5 uppercase tracking-wide">
                <ShieldAlert className="w-4 h-4" />
                Протокол антисписування
              </span>
              <span className="text-xs text-slate-400">
                Зафіксовано подій: <strong>{data.antiCheatEvents.length}</strong>
              </span>
            </div>

            {data.antiCheatEvents.length === 0 ? (
              <div className="text-xs text-emerald-400 flex items-center gap-1.5 pt-1">
                <CheckCircle2 className="w-4 h-4" />
                Порушень регламенту не виявлено. Кадет не залишав вкладку та складав іспит чесно.
              </div>
            ) : (
              <div className="space-y-1.5 pt-1">
                {data.antiCheatEvents.map((event: any, i: number) => {
                  const evTime = new Date(event.timestamp).toLocaleTimeString('uk-UA');
                  return (
                    <div
                      key={i}
                      className="text-xs p-2.5 rounded-lg bg-red-500/5 border border-red-500/20 text-red-300 flex items-start justify-between gap-3"
                    >
                      <div className="flex items-center gap-2">
                        <AlertTriangle className="w-3.5 h-3.5 text-red-400 shrink-0" />
                        <span>{event.details}</span>
                      </div>
                      <span className="font-mono text-[10px] text-red-400 shrink-0">{evTime}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          {/* Section 1: Closed Questions Breakdown */}
          {closedAnswers.length > 0 && (
            <div className="space-y-4">
              <div className="flex items-center justify-between">
                <h3 className="text-sm font-bold text-white flex items-center gap-2">
                  <FileText className="w-4 h-4 text-amber-400" />
                  Автоматично перевірені тести ({closedAnswers.length} питань)
                </h3>
                <span className="text-xs text-slate-400">
                  {closedAnswers.filter((a: any) => a.isCorrect).length} з {closedAnswers.length} правильно
                </span>
              </div>

              <div className="space-y-3">
                {closedAnswers.map((ans: any, idx: number) => {
                  const isCorrect = ans.isCorrect;
                  return (
                    <div
                      key={ans.questionId}
                      className={`p-4 rounded-xl border text-xs space-y-3 transition-colors ${
                        isCorrect
                          ? 'bg-slate-950/60 border-emerald-500/30'
                          : 'bg-slate-950/60 border-red-500/30'
                      }`}
                    >
                      <div className="flex items-start justify-between gap-2">
                        <div className="font-semibold text-white text-sm">
                          {idx + 1}. {ans.title}
                        </div>
                        <div className="shrink-0">
                          {isCorrect ? (
                            <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                              +{ans.autoScore} б. (Правильно)
                            </span>
                          ) : (
                            <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/10 text-red-400 border border-red-500/20">
                              0 б. (Помилка)
                            </span>
                          )}
                        </div>
                      </div>

                      {/* Options breakdown */}
                      {ans.options && (
                        <div className="space-y-1.5 pl-2 border-l-2 border-slate-800">
                          {ans.options.map((optText: string, oIdx: number) => {
                            const isSelected =
                              ans.type === 'single'
                                ? ans.selectedOption === oIdx
                                : (ans.selectedOptions || []).includes(oIdx);

                            const isTargetCorrect =
                              ans.type === 'single'
                                ? ans.correctOption === oIdx
                                : (ans.correctOptions || []).includes(oIdx);

                            let style = 'text-slate-400';
                            if (isSelected && isTargetCorrect) {
                              style = 'text-emerald-300 font-semibold';
                            } else if (isSelected && !isTargetCorrect) {
                              style = 'text-red-300 font-semibold line-through';
                            } else if (!isSelected && isTargetCorrect) {
                              style = 'text-emerald-400/90 underline';
                            }

                            return (
                              <div key={oIdx} className={`flex items-start gap-2 ${style}`}>
                                <span className="font-mono text-[10px]">
                                  {isSelected ? '👉' : '—'}
                                </span>
                                <span>{optText}</span>
                                {isTargetCorrect && (
                                  <span className="text-[10px] text-emerald-400 font-mono ml-auto">
                                    [Правильна відповідь]
                                  </span>
                                )}
                              </div>
                            );
                          })}
                        </div>
                      )}

                      {ans.explanation && (
                        <div className="p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-slate-300 italic">
                          💡 Пояснення регламенту: {ans.explanation}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Section 2: Open Situational Cases (Ручна перевірка) */}
          {openAnswers.length > 0 && (
            <div className="space-y-4 pt-4 border-t border-slate-800">
              <div className="flex items-center justify-between">
                <h3 className="text-sm font-bold text-amber-400 flex items-center gap-2">
                  <MessageSquare className="w-4 h-4" />
                  Відкриті ситуаційні кейси (Оцінює інструктор)
                </h3>
                <span className="text-xs text-slate-400">
                  Потребує виставлення балів за повноту дій
                </span>
              </div>

              <div className="space-y-4">
                {openAnswers.map((ans: any, idx: number) => {
                  const currentGrade = openGrades[ans.questionId] || {
                    score: ans.manualScore || 0,
                    comment: ans.instructorComment || '',
                  };

                  return (
                    <div
                      key={ans.questionId}
                      className="p-5 rounded-xl bg-slate-950 border border-amber-500/20 space-y-4"
                    >
                      <div>
                        <div className="text-xs font-bold text-white mb-1">
                          Кейс #{idx + 1}: {ans.title}
                        </div>
                        {ans.description && (
                          <div className="text-xs text-slate-400 bg-slate-900/60 p-3 rounded-lg border border-slate-800/80">
                            <strong>Ситуація:</strong> {ans.description}
                          </div>
                        )}
                      </div>

                      {/* Cadet Written Response */}
                      <div>
                        <label className="block text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">
                          Відповідь кадета:
                        </label>
                        <div className="p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-200 leading-relaxed whitespace-pre-wrap font-sans">
                          {ans.textAnswer || '— Кадет залишив це поле порожнім —'}
                        </div>
                      </div>

                      {ans.explanation && (
                        <div className="text-[11px] text-slate-400 italic">
                          📌 Рекомендація інструктору: {ans.explanation}
                        </div>
                      )}

                      {/* Instructor Scoring Controls */}
                      <div className="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-3 items-center">
                        <div>
                          <label className="block text-[11px] font-semibold text-amber-400 mb-1">
                            Оцінка за кейс (макс. {ans.maxPoints} б.):
                          </label>
                          <select
                            value={currentGrade.score}
                            onChange={(e) =>
                              handleGradeChange(ans.questionId, Number(e.target.value))
                            }
                            className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white font-bold"
                          >
                            {Array.from({ length: ans.maxPoints + 1 }).map((_, pt) => (
                              <option key={pt} value={pt}>
                                {pt} {pt === 1 ? 'бал' : 'бали'} із {ans.maxPoints}
                              </option>
                            ))}
                          </select>
                        </div>

                        <div className="sm:col-span-2">
                          <label className="block text-[11px] font-semibold text-slate-400 mb-1">
                            Коментар інструктора до цього кейсу:
                          </label>
                          <input
                            type="text"
                            placeholder="напр. Добре викликав 10-32, але забув вказати кобуру"
                            value={currentGrade.comment}
                            onChange={(e) => handleCommentChange(ans.questionId, e.target.value)}
                            className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-500"
                          />
                        </div>
                      </div>
                    </div>
                  );
                })}

                <button
                  type="button"
                  onClick={handleSaveOpenGrades}
                  disabled={savingGrades}
                  className="px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition-colors disabled:opacity-50"
                >
                  <Award className="w-4 h-4" />
                  {savingGrades ? 'Збереження...' : 'Зберегти оцінки відкритих кейсів'}
                </button>
              </div>
            </div>
          )}

          {/* Section 3: Final Instructor Verdict (Зараховано / Не зараховано / Перездача) */}
          <div className="p-5 rounded-xl bg-slate-950 border border-slate-800 space-y-4 pt-5">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <Award className="w-4 h-4 text-amber-400" />
              Остаточний вердикт та публікація в Discord
            </h3>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-2">
                Оберіть рішення інструктора:
              </label>
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button
                  type="button"
                  onClick={() => setDecision('passed')}
                  className={`p-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all ${
                    decision === 'passed'
                      ? 'bg-emerald-500/20 border-emerald-500 text-emerald-300 shadow-sm'
                      : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700'
                  }`}
                >
                  <CheckCircle2 className="w-4 h-4" />
                  Зараховано
                </button>

                <button
                  type="button"
                  onClick={() => setDecision('failed')}
                  className={`p-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all ${
                    decision === 'failed'
                      ? 'bg-red-500/20 border-red-500 text-red-300 shadow-sm'
                      : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700'
                  }`}
                >
                  <XCircle className="w-4 h-4" />
                  Не зараховано
                </button>

                <button
                  type="button"
                  onClick={() => setDecision('retake_allowed')}
                  className={`p-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all ${
                    decision === 'retake_allowed'
                      ? 'bg-purple-500/20 border-purple-500 text-purple-300 shadow-sm'
                      : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700'
                  }`}
                >
                  <RotateCcw className="w-4 h-4" />
                  Дозволити перездачу
                </button>
              </div>
            </div>

            <div>
              <div className="flex items-center justify-between mb-1">
                <label className="text-xs font-semibold text-slate-300">
                  Гілка у Discord Forum (куди надсилати вердикт):
                </label>
                {discordThreadId ? (
                  <span className="text-[10px] text-emerald-400 font-medium flex items-center gap-1">
                    <CheckCircle2 className="w-3 h-3" />
                    Прив'язано до гілки кадета
                  </span>
                ) : (
                  <span className="text-[10px] text-amber-400 font-medium">
                    Вкажіть ID або посилання на гілку
                  </span>
                )}
              </div>
              <input
                type="text"
                placeholder="напр. 1303847582910293847 або https://discord.com/channels/.../..."
                value={discordThreadId}
                onChange={(e) => setDiscordThreadId(e.target.value)}
                className="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-amber-300 font-mono placeholder-slate-600 focus:outline-none focus:border-amber-500"
              />
              <div className="text-[10px] text-slate-500 mt-1">
                💡 Вердикт надійде відповіддю безпосередньо в цю гілку. Якщо поле порожнє, клікніть правою кнопкою на створену гілку кадета в Discord ➔ «Копіювати посилання» або «Копіювати ID» і вставте сюди.
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1.5">
                Коментар інструктора (буде надіслано кадету в Discord гілку):
              </label>
              <textarea
                rows={3}
                placeholder="Вкажіть сильні та слабкі сторони, над чим попрацювати або причину перездачі..."
                value={decisionComment}
                onChange={(e) => setDecisionComment(e.target.value)}
                className="w-full p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors"
              />
            </div>

            <div className="flex items-center justify-between pt-2">
              <span className="text-[11px] text-slate-400">
                Рішення миттєво опублікується в Discord Forum-канал інструкторів із тегом кадета.
              </span>

              <button
                type="button"
                onClick={handleSubmitDecision}
                disabled={submittingDecision}
                className="py-2.5 px-6 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs flex items-center gap-2 transition-all shadow-md shadow-amber-500/20 disabled:opacity-50 shrink-0"
              >
                <Send className="w-4 h-4" />
                {submittingDecision ? 'Надсилання...' : 'Опублікувати вердикт у Discord'}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};
